pragma language_version >= 0.20;

import CompactStandardLibrary;

include "../../../../prototypes/credential-families/birth-secret/src/secret-birth-credential";

export enum RevocationVerificationMode {
  noVerification,
  verifierSuppliedRoot,
  authorityAttested
}

export enum RevocationAccessDecision {
  noDecision,
  approved,
  unknownCapability,
  alreadyConsumed
}

export ledger contractVersion: Uint<32>;
export ledger issuedCredentialCount: Counter;
export ledger verifiedPresentationCount: Counter;
export sealed ledger minimumAccessAgeYears: Uint<8>;
export sealed ledger requireVerifierScopedPseudonym: Boolean;
export ledger issuedCredentialClaimRoots: Set<Bytes<32>>;
export ledger lastVerifiedCredentialRoot: Bytes<32>;
export ledger lastVerifiedCurrentDay: Uint<32>;
export ledger lastVerifiedCurrentTime: Uint<64>;
export ledger lastVerifiedThresholdYears: Uint<8>;
export ledger lastVerifiedRequestChallenge: Bytes<32>;
export ledger lastVerifiedStatusRegistryId: Bytes<32>;
export ledger lastVerifiedRevokedRoot: Bytes<32>;
export ledger lastVerificationMode: RevocationVerificationMode;
export ledger issuedAccessCapabilityCount: Counter;
export ledger consumedAccessCapabilityCount: Counter;
export ledger activeAccessCapabilities: Set<Bytes<32>>;
export ledger consumedAccessCapabilities: Set<Bytes<32>>;
export ledger lastIssuedAccessCapability: Bytes<32>;
export ledger lastBusinessDecision: RevocationAccessDecision;

witness holderSecret(): Bytes<32>;
witness holderSecretOpening(): Bytes<32>;
witness holderBindingBlindingFactor(): Bytes<32>;
witness holderBirthDateDays(): Uint<32>;
witness holderBirthDateOpening(): Bytes<32>;

constructor() {
  contractVersion = 1;
  minimumAccessAgeYears = 18;
  requireVerifierScopedPseudonym = true;
  lastVerifiedCredentialRoot = pad(32, "vc-demo:rev:none");
  lastVerifiedCurrentDay = 0;
  lastVerifiedCurrentTime = 0;
  lastVerifiedThresholdYears = 0;
  lastVerifiedRequestChallenge = pad(32, "vc-demo:rev:no-request");
  lastVerifiedStatusRegistryId = pad(32, "vc-demo:rev:no-registry");
  lastVerifiedRevokedRoot = pad(32, "vc-demo:rev:no-root");
  lastVerificationMode = RevocationVerificationMode.noVerification;
  lastIssuedAccessCapability = pad(32, "vc-demo:rev:no-capability");
  lastBusinessDecision = RevocationAccessDecision.noDecision;
}

pure circuit revocationDemoVerificationMessageId(
  verifierChallengeHash: Bytes<32>,
  verifierDomainHash: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "vc-demo:rev:message"),
    verifierChallengeHash,
    verifierDomainHash
  ]);
}

pure circuit revocationDemoVerificationThreadId(
  verifierChallengeHash: Bytes<32>,
  verifierDomainHash: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "vc-demo:rev:thread"),
    verifierChallengeHash,
    verifierDomainHash
  ]);
}

pure circuit revocationDemoStatusPolicy(
  capabilityKind: StatusCapabilityKind,
  registryId: Bytes<32>
): VerifierStatusPolicy {
  return VerifierStatusPolicy {
    requireStatus: true,
    acceptedStatusCapability: capabilityKind,
    enforceRegistryId: true,
    acceptedRegistryId: registryId,
    enforceAttestationMaxAge: false,
    maxAttestationAge: 0,
  };
}

pure circuit revocationDemoAuthorityAttestedStatusPolicy(
  registryId: Bytes<32>
): VerifierStatusPolicy {
  return VerifierStatusPolicy {
    requireStatus: true,
    acceptedStatusCapability: StatusCapabilityKind.authorityAttestedStatus,
    enforceRegistryId: true,
    acceptedRegistryId: registryId,
    enforceAttestationMaxAge: true,
    maxAttestationAge: 50,
  };
}

export circuit revocationAwareAgeGateVerificationRequest(
  issuerVerificationMethodRef: VerificationMethodRef,
  verifierDomainHash: Bytes<32>,
  verifierChallengeHash: Bytes<32>
): SecretBirthCredentialVerificationRequest {
  return SecretBirthCredentialVerificationRequest {
    envelope: ProtocolMessageEnvelope {
      version: 1,
      messageId: revocationDemoVerificationMessageId(
        verifierChallengeHash,
        verifierDomainHash
      ),
      threadId: revocationDemoVerificationThreadId(
        verifierChallengeHash,
        verifierDomainHash
      ),
      initialMessage: true,
      respondsToMessageId: noProtocolResponseReference(),
      createdAt: 1,
      hasExpiresAt: false,
      expiresAt: 0,
    },
    schema: SchemaRef {
      packageId: pad(32, "midnight-did:vc:birth-secret"),
      schemaId: pad(32, "birth-credential:v1"),
      majorVersion: 1,
      minorVersion: 0,
    },
    issuerVerificationMethodRef: issuerVerificationMethodRef,
    holderBindingProfile: HolderBindingProfile.blindedSecretHolder,
    features: CredentialProtocolFeatures {
      supportsSelectiveDisclosure: true,
      supportsPredicateProofs: true,
      supportsVerifierScopedPseudonym: true,
      supportsSameHolderProof: true,
    },
    verifierChallengeHash: verifierChallengeHash,
    body: SecretBirthCredentialVerificationRequestBody {
      requireSubjectIdCommitmentDisclosure: false,
      requireBirthCountryDisclosure: false,
      requireVerifierScopedPseudonym: requireVerifierScopedPseudonym,
      verifierDomainHash: verifierDomainHash,
      requireAgeOverThreshold: true,
      requestedAgeThresholdYears: minimumAccessAgeYears,
    },
  };
}

export circuit revocationAwareVerifierSuppliedRootRequest(
  issuerVerificationMethodRef: VerificationMethodRef,
  verifierDomainHash: Bytes<32>,
  verifierChallengeHash: Bytes<32>,
  registryState: RevocationRegistryState
): SecretBirthCredentialVerificationRevokedSetStatusRequest {
  return SecretBirthCredentialVerificationRevokedSetStatusRequest {
    verificationRequest: revocationAwareAgeGateVerificationRequest(
      issuerVerificationMethodRef,
      verifierDomainHash,
      verifierChallengeHash
    ),
    statusPolicy: revocationDemoStatusPolicy(
      StatusCapabilityKind.revokedSetNonMembership,
      registryState.registryId
    ),
    statusRequest: RevokedSetStatusRequest {
      registryState: registryState,
      verifierChallengeHash: verifierChallengeHash,
    },
  };
}

export circuit revocationAwareAuthorityAttestedRequest(
  issuerVerificationMethodRef: VerificationMethodRef,
  verifierDomainHash: Bytes<32>,
  verifierChallengeHash: Bytes<32>,
  registryState: RevocationRegistryState
): SecretBirthCredentialVerificationAuthorityAttestedStatusRequest {
  return SecretBirthCredentialVerificationAuthorityAttestedStatusRequest {
    verificationRequest: revocationAwareAgeGateVerificationRequest(
      issuerVerificationMethodRef,
      verifierDomainHash,
      verifierChallengeHash
    ),
    statusPolicy: revocationDemoAuthorityAttestedStatusPolicy(
      registryState.registryId
    ),
    statusRequest: RevokedSetStatusRequest {
      registryState: registryState,
      verifierChallengeHash: verifierChallengeHash,
    },
  };
}

pure circuit revocationAwareCapability(
  credentialRoot: Bytes<32>,
  verifierChallengeHash: Bytes<32>,
  revokedRoot: Bytes<32>,
  issuanceIndex: Uint<64>
): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "vc-demo:revocation-gate"),
    credentialRoot,
    verifierChallengeHash,
    revokedRoot,
    ((issuanceIndex as Field) as Bytes<32>)
  ]);
}

export circuit issueSecretBirthCredential(
  credential: SecretBirthCredential,
  credentialProof: Proof
): [] {
  const credentialRoot = disclose(secretBirthCredentialBodyRoot(credential));

  assertValidSecretBirthCredential(credential, credentialProof);
  assert(
    !issuedCredentialClaimRoots.member(credentialRoot),
    "Secret birth credential has already been issued into the revocation demo contract"
  );

  issuedCredentialClaimRoots.insert(credentialRoot);
  issuedCredentialCount.increment(1);
}

