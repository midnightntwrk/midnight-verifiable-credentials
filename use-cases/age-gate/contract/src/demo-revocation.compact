circuit verifySecretBirthPresentationWithAuthorityAttestedStatus(
  credentialWithStatus: SecretBirthCredentialWithStatusBinding,
  request: SecretBirthCredentialVerificationAuthorityAttestedStatusRequest,
  submission: SecretBirthCredentialVerificationSubmission,
  statusInputs: SecretBirthCredentialVerificationAuthorityAttestedStatusProtocolInputs,
  currentDay: Uint<32>,
  currentTime: Uint<64>
): [] {
  const credentialRoot = disclose(secretBirthCredentialBodyRoot(
    credentialWithStatus.credential
  ));

  assert(issuedCredentialClaimRoots.member(credentialRoot),
    "Secret birth credential was not issued by the revocation demo contract"
  );
  assertSecretBirthCredentialVerificationSubmissionMatchesAuthorityAttestedStatusProtocolRequest(
    credentialWithStatus,
    request,
    submission,
    statusInputs,
    holderSecret(),
    holderSecretOpening(),
    holderBindingBlindingFactor(),
    currentTime
  );
  if (credentialWithStatus.credential.hasExpiration) {
    assert(
      currentDay <= credentialWithStatus.credential.expiresAt,
      "Secret birth credential has expired for the supplied verification day"
    );
  }
  assertValidSecretBirthCredentialAgePredicate(
    credentialWithStatus.credential,
    submission.body.presentation,
    currentDay,
    holderBirthDateDays(),
    holderBirthDateOpening()
  );

  lastVerifiedCredentialRoot = credentialRoot;
  lastVerifiedCurrentDay = disclose(currentDay);
  lastVerifiedCurrentTime = disclose(currentTime);
  lastVerifiedThresholdYears = disclose(
    submission.body.presentation.disclosed.ageThresholdYears
  );
  lastVerifiedRequestChallenge = disclose(
    request.verificationRequest.verifierChallengeHash
  );
  lastVerifiedStatusRegistryId = disclose(
    request.statusRequest.registryState.registryId
  );
  lastVerifiedRevokedRoot = disclose(
    request.statusRequest.registryState.revokedRoot
  );
  lastVerificationMode = RevocationVerificationMode.authorityAttested;
  verifiedPresentationCount.increment(1);
}

export circuit issueRevocationAwareCapabilityWithVerifierSuppliedRoot(
  credentialWithStatus: SecretBirthCredentialWithStatusBinding,
  request: SecretBirthCredentialVerificationRevokedSetStatusRequest,
  submission: SecretBirthCredentialVerificationSubmission,
  statusInputs: SecretBirthCredentialVerificationRevokedSetStatusInputs,
  currentDay: Uint<32>
): Bytes<32> {
  const credentialRoot = secretBirthCredentialBodyRoot(
    credentialWithStatus.credential
  );
  const capability = disclose(revocationAwareCapability(
    credentialRoot,
    request.verificationRequest.verifierChallengeHash,
    request.statusRequest.registryState.revokedRoot,
    issuedAccessCapabilityCount.read()
  ));

  verifySecretBirthPresentationWithVerifierSuppliedRoot(
    credentialWithStatus,
    request,
    submission,
    statusInputs,
    currentDay
  );

  activeAccessCapabilities.insert(capability);
  issuedAccessCapabilityCount.increment(1);
  lastIssuedAccessCapability = capability;
  lastBusinessDecision = RevocationAccessDecision.approved;
  return capability;
}

export circuit issueRevocationAwareCapabilityWithAuthorityAttestation(
  credentialWithStatus: SecretBirthCredentialWithStatusBinding,
  request: SecretBirthCredentialVerificationAuthorityAttestedStatusRequest,
  submission: SecretBirthCredentialVerificationSubmission,
  statusInputs: SecretBirthCredentialVerificationAuthorityAttestedStatusProtocolInputs,
  currentDay: Uint<32>,
  currentTime: Uint<64>
): Bytes<32> {
  const credentialRoot = secretBirthCredentialBodyRoot(
    credentialWithStatus.credential
  );
  const capability = disclose(revocationAwareCapability(
    credentialRoot,
    request.verificationRequest.verifierChallengeHash,
    request.statusRequest.registryState.revokedRoot,
    issuedAccessCapabilityCount.read()
  ));

  verifySecretBirthPresentationWithAuthorityAttestedStatus(
    credentialWithStatus,
    request,
    submission,
    statusInputs,
    currentDay,
    currentTime
  );

  activeAccessCapabilities.insert(capability);
  issuedAccessCapabilityCount.increment(1);
  lastIssuedAccessCapability = capability;
  lastBusinessDecision = RevocationAccessDecision.approved;
  return capability;
}

export circuit claimRevocationAwareCapability(
  capability: Bytes<32>
): RevocationAccessDecision {
  const disclosedCapability = disclose(capability);

  if (activeAccessCapabilities.member(disclosedCapability)) {
    activeAccessCapabilities.remove(disclosedCapability);
    consumedAccessCapabilities.insert(disclosedCapability);
    consumedAccessCapabilityCount.increment(1);
    lastBusinessDecision = RevocationAccessDecision.approved;
    return RevocationAccessDecision.approved;
  }
  if (consumedAccessCapabilities.member(disclosedCapability)) {
    lastBusinessDecision = RevocationAccessDecision.alreadyConsumed;
    return RevocationAccessDecision.alreadyConsumed;
  }

  lastBusinessDecision = RevocationAccessDecision.unknownCapability;
  return RevocationAccessDecision.unknownCapability;
}
