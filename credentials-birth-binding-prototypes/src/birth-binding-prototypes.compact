export circuit assertValidBirthSecretPresentation(
  credential: BirthSecretCredential,
  credentialProof: Proof,
  presentation: BirthSecretPresentation,
  verifierChallengeHash: Bytes<32>,
  holderSecret: Bytes<32>,
  holderSecretOpening: Bytes<32>
): [] {
  assertValidBirthSecretCredential(credential, credentialProof);
  assertValidBirthBindingPrototypeSchema(presentation.schema);
  BirthSecret_assertValidPresentationEnvelope(credential, presentation);
  assertValidSecretHolderPresentationBinding(presentation.holderBinding);
  assertMatchingSecretHolderBindings(
    credential.holderBinding,
    presentation.holderBinding
  );
  assertBirthDisclosuresMatchClaims(credential.claims, presentation.disclosed);
  assertSecretHolderBindingWitness(
    presentation.holderBinding,
    verifierChallengeHash,
    holderSecret,
    holderSecretOpening
  );
}

