export enum HolderBindingProfile {
  explicitDid,
  secretHolder,
  blindedSecretHolder
}

export struct CredentialProtocolFeatures {
  supportsSelectiveDisclosure: Boolean,
  supportsPredicateProofs: Boolean,
  supportsVerifierScopedPseudonym: Boolean,
  supportsSameHolderProof: Boolean,
}

export struct VerifierStatusPolicy {
  requireStatus: Boolean,
  acceptedStatusCapability: StatusCapabilityKind,
  enforceRegistryId: Boolean,
  acceptedRegistryId: Bytes<32>,
  // `maxAttestationAge` uses the same time unit as the verifier-supplied
  // `currentTime` and the authority-attested proof `createdAt`.
  enforceAttestationMaxAge: Boolean,
  maxAttestationAge: Uint<64>,
}

export struct ProtocolMessageEnvelope {
  version: Uint<16>,
  messageId: Bytes<32>,
  threadId: Bytes<32>,
  initialMessage: Boolean,
  respondsToMessageId: Bytes<32>,
  createdAt: Uint<64>,
  hasExpiresAt: Boolean,
  expiresAt: Uint<64>,
}

export circuit noProtocolResponseReference(): Bytes<32> {
  return pad(32, "midnight:vc:protocol:none");
}

export circuit assertValidVerificationMethodRef(
  verificationMethodRef: VerificationMethodRef
): [] {
  assert(
    verificationMethodRef.methodId != pad(32, ""),
    "Verification method reference must be set"
  );
}

export circuit assertValidStatusRegistryRef(
  registryRef: StatusRegistryRef
): [] {
  assert(
    registryRef.registryId != pad(32, ""),
    "Status registry id must be set"
  );
  assertValidVerificationMethodRef(registryRef.authorityVerificationMethodRef);
}

export circuit assertValidNoStatusCapability(
  capability: NoStatusCapability
): [] {
}

export circuit assertValidNoStatusBinding(
  binding: NoStatusBinding
): [] {
}

export circuit assertValidRegistryBoundStatusBinding(
  binding: RegistryBoundStatusBinding
): [] {
  assertValidStatusRegistryRef(binding.registryRef);
  assert(
    binding.statusHandleCommitment != pad(32, ""),
    "Status handle commitment must be set"
  );
}

export circuit assertValidRevokedSetNonMembershipStatusCapability(
  capability: RevokedSetNonMembershipStatusCapability
): [] {
  assertValidStatusRegistryRef(capability.registryRef);
  assert(
    capability.statusHandleCommitment != pad(32, ""),
    "Status handle commitment must be set"
  );
}

export circuit assertValidAuthorityAttestedStatusCapability(
  capability: AuthorityAttestedStatusCapability
): [] {
  assertValidStatusRegistryRef(capability.registryRef);
  assert(
    capability.statusHandleCommitment != pad(32, ""),
    "Authority-attested status handle commitment must be set"
  );
}

export circuit assertValidVerifierStatusPolicy(
  policy: VerifierStatusPolicy
): [] {
  if (policy.requireStatus) {
    assert(
      policy.acceptedStatusCapability != StatusCapabilityKind.noStatus,
      "Required status policy must request a real status capability"
    );
  } else {
    assert(
      policy.acceptedStatusCapability == StatusCapabilityKind.noStatus,
      "Optional status policy must collapse to NoStatusCapability"
    );
    assert(
      !policy.enforceRegistryId,
      "Optional status policy must not enforce a registry"
    );
    assert(
      !policy.enforceAttestationMaxAge,
      "Optional status policy must not enforce attestation max-age"
    );
    assert(
      policy.maxAttestationAge == 0,
      "Optional status policy must not set attestation max-age"
    );
  }

  if (policy.enforceRegistryId) {
    assert(
      policy.acceptedRegistryId != pad(32, ""),
      "Accepted status registry id must be set when enforced"
    );
  }

  if (policy.enforceAttestationMaxAge) {
    assert(
      policy.acceptedStatusCapability == StatusCapabilityKind.authorityAttestedStatus,
      "Attestation max-age policy only applies to authority-attested status"
    );
    assert(
      policy.maxAttestationAge >= 1,
      "Attestation max-age policy must request a real freshness window"
    );
  } else {
    assert(
      policy.maxAttestationAge == 0,
      "Disabled attestation max-age policy must not carry a freshness window"
    );
  }
}

export circuit assertMatchingSchemaRefs(
  expected: SchemaRef,
  actual: SchemaRef
): [] {
  assert(
    expected.packageId == actual.packageId
      && expected.schemaId == actual.schemaId
      && expected.majorVersion == actual.majorVersion
      && expected.minorVersion == actual.minorVersion,
    "Schema reference mismatch"
  );
}

export circuit assertValidProtocolMessageEnvelope(
  envelope: ProtocolMessageEnvelope
): [] {
  const noResponse = noProtocolResponseReference();
  assert(envelope.version == 1, "Protocol message version mismatch");
  assert(envelope.messageId != noResponse, "Protocol message id must be set");
  assert(envelope.threadId != noResponse, "Protocol thread id must be set");
  if (envelope.initialMessage) {
    assert(
      envelope.respondsToMessageId == noResponse,
      "Initial protocol message must not reference a previous message"
    );
  } else {
    assert(
      envelope.respondsToMessageId != noResponse,
      "Protocol response message must reference a previous message"
    );
  }
  if (envelope.hasExpiresAt) {
    assert(
      envelope.expiresAt >= envelope.createdAt,
      "Protocol message expiration must not precede creation"
    );
  }
}

export circuit assertProtocolResponseEnvelope(
  requestEnvelope: ProtocolMessageEnvelope,
  responseEnvelope: ProtocolMessageEnvelope
): [] {
  assertValidProtocolMessageEnvelope(requestEnvelope);
  assertValidProtocolMessageEnvelope(responseEnvelope);
  assert(!responseEnvelope.initialMessage, "Protocol response must not be initial");
  assert(
    responseEnvelope.threadId == requestEnvelope.threadId,
    "Protocol response thread id does not match the request thread id"
  );
  assert(
    responseEnvelope.respondsToMessageId == requestEnvelope.messageId,
    "Protocol response does not reference the request message id"
  );
  assert(
    responseEnvelope.createdAt >= requestEnvelope.createdAt,
    "Protocol response creation time must not precede the request"
  );
}
