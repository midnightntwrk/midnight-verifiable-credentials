{
  "name": "midnight-verifiable-credentials",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "check:package-boundaries": "bash ./tooling/scripts/check-package-boundaries.sh && node ./tooling/scripts/workspace-catalog.mjs --check",
    "clean:artifacts": "pnpm run clean && rm -rf .turbo tooling/artifacts/npm",
    "check:release-package-contract": "node ./tooling/scripts/check-release-package-contract.mjs",
    "test:release-tooling": "node --test ./tooling/scripts/release-tooling.test.mjs",
    "test:core-conformance": "node --test ./tooling/scripts/core-conformance.test.mjs ./tooling/scripts/core-compact-conformance.test.mjs",
    "docs:links": "node ./tooling/scripts/check-markdown-links.mjs README.md AGENT.md CONTRIBUTING.md .github .codex/skills .claude/skills docs spec conformance packages examples tooling",
    "artifacts:pack": "./tooling/scripts/pack-artifacts.sh",
    "clean": "turbo run clean --continue",
    "lint": "turbo run lint --continue",
    "lint:fix": "turbo run lint:fix --continue",
    "build": "turbo run build --continue",
    "test": "turbo run test --continue",
    "typecheck": "turbo run typecheck --continue",
    "ci:lint": "pnpm run check:package-boundaries && pnpm run test:release-tooling && pnpm run check:release-package-contract && pnpm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "5.0.9",
      "brace-expansion@2": "5.0.9",
      "brace-expansion@5": "5.0.9",
      "js-yaml": "4.3.1",
      "postcss": "8.5.23",
      "vite": "7.3.6"
    },
    "patchedDependencies": {
      "brace-expansion@5.0.9": "patches/brace-expansion@5.0.9.patch"
    }
  }
}
