# Repository-specific dev-loops policy for midnight-verifiable-credentials.
# This file intentionally uses only the config schema supported by dev-loops 0.9.0.
version: 1

gates:
  draft:
    angles:
      - scope
      - correctness
      - coverage
      - ci-guard
      - contract-surface
      - contract-artifacts
      - docs
      - link-check
      - config-drift
      - packaging-runtime
      - midnight-vc-surface
      - security
      - external-review
    mandatoryAngles:
      - external-review
      - pr-description
  preApproval:
    angles:
      - correctness
      - coverage
      - contract-surface
      - contract-artifacts
      - ci-guard
      - docs
      - link-check
      - config-drift
      - packaging-runtime
      - security
      - midnight-vc-surface
      - external-review
    mandatoryAngles:
      - external-review
      - pr-checklist-matrix

personas:
  security:
    persona: review
    prompt: >-
      Review for secret exposure, unsafe proof/key or claim-opening handling,
      authorization bypasses, status/revocation fail-open behavior, dependency
      or supply-chain risk, and unsafe GitHub workflow behavior. Report
      concrete findings with file and line references.
    defaultModel: null

  midnight-vc-surface:
    persona: review
    prompt: >-
      Review reusable VC/VP model, Compact primitives, capabilities,
      registries, protocol bindings, runtime adapters, package exports,
      specifications, and downstream compatibility boundaries. Find drift,
      duplicated ownership, stale public behavior, missing validation, or
      concrete credential-family code escaping prototype/use-case boundaries.
      Keep DID method behavior in midnight-did and releasable credential
      families in independent repositories. Report concrete findings with file
      and line references.
    defaultModel: null

  contract-artifacts:
    persona: review
    prompt: >-
      For Compact contract changes, compare generated circuit k, rows, prover
      key, verifier key, zkir, and bzkir sizes against the base branch. Flag k
      increases, unexpected artifact growth, stale generated artifacts, missing
      negative tests, and specification drift. Report concrete findings with
      file and line references.
    defaultModel: null

  external-review:
    persona: review
    prompt: >-
      Required independent local CLI review: run `codex review --base
      origin/develop` against the current PR head before returning a verdict.
      Do not modify files. Review for correctness, security, stale docs,
      package/API compatibility, tests, and regression risk. For Compact
      changes, check authorization binding, witness secrecy, claim-opening
      handling, status freshness, managed artifact freshness, circuit k/size
      changes, and spec/docs drift. Return only actionable findings with
      file/line references, or "No findings".
    defaultModel: null

refinement:
  fanOut: 3
  maxCopilotRounds: 0

autonomy:
  # Supported stop boundaries preserve the human-only merge gate. Draft-first
  # plus the draft gate keeps ready-for-review after validation only.
  stopAt:
    - pre-approval
    - merge
  humanMergeOnly: true

workflow:
  requireDraftFirst: true
  requireRetrospective: true
  devModeDefault: false
