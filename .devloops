# Repository-specific dev-loops policy for midnight-verifiable-credentials.
# This file intentionally uses only the config schema supported by dev-loops 0.9.0.
version: 1

gates:
  draft:
    angles:
      - scope
      - correctness
      - coverage
      - contract-surface
      - docs
      - packaging-runtime
      - midnight-vc-surface
      - security
      - external-review
    mandatoryAngles:
      - external-review
      - pr-description
  preApproval:
    angles:
      - correctness
      - coverage
      - contract-surface
      - docs
      - packaging-runtime
      - security
      - midnight-vc-surface
      - external-review
    mandatoryAngles:
      - external-review
      - pr-checklist-matrix

personas:
  security:
    persona: review
    prompt: >-
      Review retained core code for secret or witness exposure, invalid proof,
      holder, issuer, or status-reference binding, fail-open status semantics,
      dependency risk, and unsafe GitHub workflow behavior. Ignore deleted
      application and protocol surfaces. Report concrete findings with file
      and line references.
    defaultModel: null

  midnight-vc-surface:
    persona: review
    prompt: >-
      Review the protocol-independent VC/VP specification, bounded model,
      generic Compact implementation, conformance, package exports, and
      downstream compatibility boundaries. Find drift, duplicated ownership,
      stale public behavior, missing validation, or transport, application,
      and concrete-family behavior entering the core release graph. Keep DID
      method behavior in midnight-did, releasable credential families in
      independent repositories, and runnable use cases in
      midnight-identity-solution-examples. Report concrete findings with file
      and line references.
    defaultModel: null

  external-review:
    persona: review
    prompt: >-
      Required independent local CLI review: resolve the current pull request's
      actual base ref and run `codex review --base origin/<base-ref>` against
      the current PR head before returning a verdict.
      Do not modify files. Review for correctness, security, stale docs,
      package/API compatibility, tests, and regression risk. For Compact
      changes, check proof, holder, issuer, and status-reference binding,
      witness exposure, managed artifact freshness, negative vectors, and spec
      drift. Ignore deleted application and protocol surfaces. Return only
      actionable findings with file/line references, or "No findings".
    defaultModel: null

refinement:
  fanOut: 2
  # Required by the full 0.9.0 schema; preserves the installed default.
  mode: parallel
  maxCopilotRounds: 0

autonomy:
  # Supported stop boundaries preserve the human-only merge gate. Draft-first
  # plus the draft gate keeps ready-for-review after validation only.
  stopAt:
    - pre-approval
    - merge
  humanMergeOnly: true

workflow:
  requireDraftFirst: true
  requireRetrospective: true
  devModeDefault: false

# The mandatory external-review angle must run for every PR, including small diffs.
localImplementation:
  lightMode:
    enabled: false
    maxFiles: 2
    maxLines: 100
