pragma language_version >= 0.20;

import CompactStandardLibrary;

include "../../../../../packages/prototypes/credential-families/university-diploma/src/university-diploma-credential";

export ledger contractVersion: Uint<32>;
export ledger successfulJobApplicationVerificationCount: Counter;
export ledger successfulDiscountVerificationCount: Counter;
export ledger lastVerifiedCredentialRoot: Bytes<32>;
export ledger lastVerifiedRequestChallenge: Bytes<32>;
export ledger lastVerifiedGraduateName: Bytes<32>;
export ledger lastVerifiedUniversityName: Bytes<32>;
export ledger lastVerifiedAwardName: Bytes<32>;
export ledger lastVerifiedGraduationYear: Uint<16>;
export ledger lastVerifiedFinalGrade: Uint<8>;
export ledger lastVerifiedDiscountThreshold: Uint<8>;
export ledger lastVerifiedVerifierKind: Uint<8>;

constructor() {
  contractVersion = 2;
  lastVerifiedCredentialRoot = pad(32, "university:none");
  lastVerifiedRequestChallenge = pad(32, "university:no-request");
  lastVerifiedGraduateName = pad(32, "");
  lastVerifiedUniversityName = pad(32, "");
  lastVerifiedAwardName = pad(32, "");
  lastVerifiedGraduationYear = 0;
  lastVerifiedFinalGrade = 0;
  lastVerifiedDiscountThreshold = 0;
  lastVerifiedVerifierKind = 0;
}

// Production commitment-backed schema (uni-diploma:v2): three public routing
// claims plus eight salted per-field commitments. Fixes #267 — the presented
// credential no longer carries plaintext for hidden claims at all.
export pure circuit universityDiplomaSchemaRef(): SchemaRef {
  return SchemaRef {
    packageId: pad(32, "midnight:vc:uni-diploma"),
    schemaId: pad(32, "uni-diploma:v2"),
    majorVersion: 2,
    minorVersion: 0,
  };
}

// Request-builder helper for employer-side university diploma checks.
// Fields the employer does not require stay hidden: they exist in the
// presented credential only as salted commitments.
export pure circuit universityJobApplicationRequest(
  issuerVerificationMethodRef: VerificationMethodRef,
  verifierChallengeHash: Bytes<32>,
  requireDiplomaIdDisclosure: Boolean,
  requireStudentIdDisclosure: Boolean,
  requireFacultyNameDisclosure: Boolean,
  requireHonorsCodeDisclosure: Boolean,
  requireGraduationMonthDisclosure: Boolean,
  requireFinalGradeDisclosure: Boolean,
  requireCreditsEarnedDisclosure: Boolean
): UniversityDiplomaProductionPresentationRequest {
  return UniversityDiplomaProductionPresentationRequest {
    version: 1,
    schema: universityDiplomaSchemaRef(),
    issuerVerificationMethodRef: issuerVerificationMethodRef,
    requireDiplomaIdDisclosure: requireDiplomaIdDisclosure,
    requireStudentIdDisclosure: requireStudentIdDisclosure,
    requireGraduateNameDisclosure: true,
    requireUniversityNameDisclosure: true,
    requireFacultyNameDisclosure: requireFacultyNameDisclosure,
    requireAwardNameDisclosure: true,
    requireHonorsCodeDisclosure: requireHonorsCodeDisclosure,
    requireGraduationYearDisclosure: true,
    requireGraduationMonthDisclosure: requireGraduationMonthDisclosure,
    requireFinalGradeDisclosure: requireFinalGradeDisclosure,
    requireCreditsEarnedDisclosure: requireCreditsEarnedDisclosure,
    enforceMinimumFinalGrade: false,
    minimumFinalGrade: 0,
    verifierChallengeHash: verifierChallengeHash,
  };
}

// Request-builder helper for the university discount use case.
// Reveal-nothing predicate request: no claim disclosure is demanded; the
// grade threshold is proven in-circuit against the salted finalGrade
// commitment via the holder's predicate witness.
export pure circuit universityMallDiscountRequest(
  issuerVerificationMethodRef: VerificationMethodRef,
  verifierChallengeHash: Bytes<32>,
  minimumFinalGrade: Uint<8>
): UniversityDiplomaProductionPresentationRequest {
  assert(
    minimumFinalGrade <= 100,
    "University discount threshold must be <= 100"
  );

  return UniversityDiplomaProductionPresentationRequest {
    version: 1,
    schema: universityDiplomaSchemaRef(),
    issuerVerificationMethodRef: issuerVerificationMethodRef,
    requireDiplomaIdDisclosure: false,
    requireStudentIdDisclosure: false,
    requireGraduateNameDisclosure: false,
    requireUniversityNameDisclosure: false,
    requireFacultyNameDisclosure: false,
    requireAwardNameDisclosure: false,
    requireHonorsCodeDisclosure: false,
    requireGraduationYearDisclosure: false,
    requireGraduationMonthDisclosure: false,
    requireFinalGradeDisclosure: false,
    requireCreditsEarnedDisclosure: false,
    enforceMinimumFinalGrade: true,
    minimumFinalGrade: minimumFinalGrade,
    verifierChallengeHash: verifierChallengeHash,
  };
}

// TRUST BOUNDARY: this contract models verifier-side request construction and
// diploma presentation checks only. It does not add revocation, protocol
// delivery, or external time/state binding. The employer-facing path persists
// only claim material the request explicitly required (opened against the
// signed commitments), while the mall-discount path proves the grade
// threshold against the finalGrade commitment without ever seeing the grade.
export circuit verifyUniversityDiplomaForJobApplication(
  credential: UniversityDiplomaProductionCredential,
  credentialProof: Proof,
  request: UniversityDiplomaProductionPresentationRequest,
  presentation: UniversityDiplomaProductionPresentation,
  presentationProof: Proof
): [] {
  const credentialRoot = disclose(
    universityDiplomaProductionCredentialBodyRoot(credential)
  );

  assert(
    request.requireGraduateNameDisclosure,
    "University job application requires graduate-name disclosure"
  );
  assert(
    request.requireUniversityNameDisclosure,
    "University job application requires university-name disclosure"
  );
  assert(
    request.requireAwardNameDisclosure,
    "University job application requires award-name disclosure"
  );
  assert(
    request.requireGraduationYearDisclosure,
    "University job application requires graduation-year disclosure"
  );
  assert(
    !request.enforceMinimumFinalGrade,
    "University job application request must not enforce a minimum grade"
  );

  assertUniversityDiplomaProductionPresentationSatisfiesRequest(
    credential,
    credentialProof,
    request,
    presentation,
    presentationProof
  );

  lastVerifiedCredentialRoot = credentialRoot;
  lastVerifiedRequestChallenge = disclose(request.verifierChallengeHash);
  // graduateName is a committed claim: the persisted value was opened against
  // the issuer-signed commitment inside the satisfies-request circuit.
  lastVerifiedGraduateName = disclose(presentation.disclosed.graduateName);
  // universityName / awardName / graduationYear are public routing claims of
  // the production profile, matched against the credential body.
  lastVerifiedUniversityName = disclose(credential.claims.universityName);
  lastVerifiedAwardName = disclose(credential.claims.awardName);
  lastVerifiedGraduationYear = disclose(credential.claims.graduationYear);
  // NOTE: `0` is the current prototype sentinel for "not disclosed on this
  // verifier request". The ledger does not yet carry a separate
  // `lastVerifiedFinalGradeDisclosed` flag.
  const requireFinalGradeDisclosure = disclose(request.requireFinalGradeDisclosure);
  if (requireFinalGradeDisclosure) {
    lastVerifiedFinalGrade = disclose(presentation.disclosed.finalGrade);
  } else {
    lastVerifiedFinalGrade = 0;
  }
  lastVerifiedDiscountThreshold = 0;
  lastVerifiedVerifierKind = 1;

  successfulJobApplicationVerificationCount.increment(1);
}

export circuit verifyUniversityDiplomaForMallDiscount(
  credential: UniversityDiplomaProductionCredential,
  credentialProof: Proof,
  request: UniversityDiplomaProductionPresentationRequest,
  presentation: UniversityDiplomaProductionPresentation,
  presentationProof: Proof,
  finalGradePredicateWitness: UniversityDiplomaProductionFinalGradePredicateWitness
): [] {
  const credentialRoot = disclose(
    universityDiplomaProductionCredentialBodyRoot(credential)
  );

  assert(
    request.enforceMinimumFinalGrade,
    "University mall discount request must enforce a minimum grade"
  );
  assert(
    !request.requireFinalGradeDisclosure,
    "University mall discount must not demand final-grade disclosure"
  );

  assertUniversityDiplomaProductionPresentationSatisfiesRequestWithFinalGradePredicate(
    credential,
    credentialProof,
    request,
    presentation,
    presentationProof,
    finalGradePredicateWitness
  );

  lastVerifiedCredentialRoot = credentialRoot;
  lastVerifiedRequestChallenge = disclose(request.verifierChallengeHash);
  lastVerifiedGraduateName = pad(32, "");
  // universityName is a public routing claim of the production profile.
  lastVerifiedUniversityName = disclose(credential.claims.universityName);
  lastVerifiedAwardName = pad(32, "");
  lastVerifiedGraduationYear = 0;
  // The mall verifier proves the threshold predicate against the finalGrade
  // commitment; the exact grade never reaches public ledger state (or the
  // verifier at all).
  lastVerifiedFinalGrade = 0;
  lastVerifiedDiscountThreshold = disclose(request.minimumFinalGrade);
  lastVerifiedVerifierKind = 2;

  successfulDiscountVerificationCount.increment(1);
}
