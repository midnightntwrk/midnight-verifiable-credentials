{
  "name": "@midnight-ntwrk/midnight-did-university-verifier-contract",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "require": "./dist/contract.js",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "require": "./dist/testing.js",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./managed/university-verifier/contract/index.js": {
      "types": "./dist/managed/university-verifier/contract/index.d.ts",
      "import": "./dist/managed/university-verifier/contract/index.js",
      "default": "./dist/managed/university-verifier/contract/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "contract": [
        "dist/contract.d.ts"
      ],
      "testing": [
        "dist/testing.d.ts"
      ],
      "managed/university-verifier/contract/index.js": [
        "dist/managed/university-verifier/contract/index.d.ts"
      ]
    }
  },
  "scripts": {
    "contract": "pnpm run compact",
    "compact": "node ../../../../tooling/scripts/ensure-compact-artifacts.mjs --manifest src/managed/.compact-artifact.json --source-root src --output src/managed/university-verifier --recipe-input scripts/strip-managed-sourcemaps.mjs -- sh -c \"compact compile src/university-verifier.compact src/managed/university-verifier && node ./scripts/strip-managed-sourcemaps.mjs\"",
    "pretest": "pnpm run compact",
    "test": "vitest run",
    "pretest:ci": "pnpm run compact",
    "test:ci": "vitest run",
    "prepack": "pnpm run build",
    "clean": "rm -rf dist && rm -rf coverage && rm -rf reports && rm -rf src/managed",
    "build": "pnpm run compact && rm -rf dist && tsc -b tsconfig.build.json --force && mkdir -p dist && cp -Rf ./src/managed ./dist/ && rm -f ./dist/managed/.compact-artifact.json && cp ./src/university-verifier.compact ./dist",
    "lint": "eslint src --ignore-pattern 'src/managed/**'",
    "lint:fix": "eslint src --fix --ignore-pattern 'src/managed/**'",
    "typecheck": "pnpm run compact && tsc -p tsconfig.json --noEmit",
    "all": "pnpm run compact && pnpm run build && pnpm run test:ci"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/midnight-did-credentials": "*",
    "@midnight-ntwrk/midnight-did-credentials-university-diploma": "*"
  },
  "files": [
    "dist/**",
    "src/**/*.compact",
    "README.md",
    "scripts/*.mjs",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "midnight": {
    "maturity": "demo",
    "packageClass": "dist"
  }
}
