{
  "name": "vc-university-bdd-scenarios",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "prepare:deps": "node ./scripts/ensure-prereqs.mjs",
    "clean": "rm -rf target",
    "typecheck": "npm run prepare:deps && tsc -p tsconfig.json --noEmit",
    "test:execute": "npm run prepare:deps && cucumber-js --config cucumber.cjs",
    "test:execute:standalone": "UNIVERSITY_BDD_BACKEND=standalone-hybrid npm run test:execute",
    "test:execute:proof-server": "UNIVERSITY_BDD_BACKEND=proof-server-contract npm run test:execute",
    "report:setup": "serenity-bdd update",
    "test:report": "npm run report:setup && serenity-bdd run --features features --output target/site/serenity",
    "test:all": "npm run clean && npm run test:execute && npm run test:report",
    "test:all:standalone": "npm run clean && npm run test:execute:standalone && npm run test:report",
    "test:all:proof-server": "npm run clean && npm run test:execute:proof-server && npm run test:report",
    "test:backend-mode:contract": "npm run prepare:deps && npx ts-node-esm ./scripts/check-backend-mode-contract.ts",
    "test:standalone-timing:contract": "npm run prepare:deps && npx ts-node-esm ./scripts/check-standalone-timing-contract.ts",
    "test:ci": "npm run test:backend-mode:contract && npm run test:standalone-timing:contract && npm run test:all",
    "test:batch-sweep:contract": "npm run prepare:deps && npx ts-node-esm ./scripts/check-batch-sweep-contract.ts",
    "batch-sweep:run": "npm run prepare:deps && npx ts-node-esm ./scripts/run-batch-sweep.ts",
    "test:batch-sweep": "npm run test:batch-sweep:contract && npm run batch-sweep:run"
  },
  "dependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@midnight-ntwrk/midnight-did-university-protocol": "*",
    "@midnight-ntwrk/midnight-did-credentials-university-diploma": "*",
    "@serenity-js/assertions": "^3.34.0",
    "@serenity-js/console-reporter": "^3.34.0",
    "@serenity-js/core": "^3.34.0",
    "@serenity-js/cucumber": "^3.34.0",
    "@serenity-js/serenity-bdd": "^3.34.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "midnight": {
    "maturity": "demo",
    "packageClass": "scenario"
  }
}
