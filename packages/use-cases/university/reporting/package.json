{
  "name": "@midnight-ntwrk/midnight-did-university-reporting",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.34.5"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.build.json --force",
    "test": "vitest run",
    "test:ci": "pnpm run test",
    "render:summary": "pnpm run build && node ./scripts/render-summary.mjs",
    "render:summary:from-artifacts": "node ./scripts/render-summary.mjs",
    "report:contract": "pnpm run build && node ./scripts/print-summary-contract.mjs",
    "report:contract:from-artifacts": "node ./scripts/print-summary-contract.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist && rm -rf coverage && rm -rf target",
    "all": "pnpm run build && pnpm run test:ci",
    "prepack": "pnpm run build"
  },
  "files": [
    "dist/**",
    "README.md",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "midnight": {
    "maturity": "demo",
    "packageClass": "dist"
  }
}
