{
  "name": "@midnight-ntwrk/midnight-did-hello-verifier-contract",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "require": "./dist/contract.js",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "require": "./dist/testing.js",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./managed/hello-verifier/contract/index.js": {
      "types": "./dist/managed/hello-verifier/contract/index.d.ts",
      "import": "./dist/managed/hello-verifier/contract/index.js",
      "default": "./dist/managed/hello-verifier/contract/index.js"
    },
    "./dummy-contract": {
      "types": "./dist/dummy-contract.d.ts",
      "require": "./dist/dummy-contract.js",
      "import": "./dist/dummy-contract.js",
      "default": "./dist/dummy-contract.js"
    },
    "./managed/dummy-claims-verifier/contract/index.js": {
      "types": "./dist/managed/dummy-claims-verifier/contract/index.d.ts",
      "import": "./dist/managed/dummy-claims-verifier/contract/index.js",
      "default": "./dist/managed/dummy-claims-verifier/contract/index.js"
    },
    "./offchain-contract": {
      "types": "./dist/offchain-contract.d.ts",
      "require": "./dist/offchain-contract.js",
      "import": "./dist/offchain-contract.js",
      "default": "./dist/offchain-contract.js"
    },
    "./managed/hello-verifier-offchain/contract/index.js": {
      "types": "./dist/managed/hello-verifier-offchain/contract/index.d.ts",
      "import": "./dist/managed/hello-verifier-offchain/contract/index.js",
      "default": "./dist/managed/hello-verifier-offchain/contract/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "contract": [
        "dist/contract.d.ts"
      ],
      "testing": [
        "dist/testing.d.ts"
      ],
      "managed/hello-verifier/contract/index.js": [
        "dist/managed/hello-verifier/contract/index.d.ts"
      ],
      "dummy-contract": [
        "dist/dummy-contract.d.ts"
      ],
      "managed/dummy-claims-verifier/contract/index.js": [
        "dist/managed/dummy-claims-verifier/contract/index.d.ts"
      ],
      "offchain-contract": [
        "dist/offchain-contract.d.ts"
      ],
      "managed/hello-verifier-offchain/contract/index.js": [
        "dist/managed/hello-verifier-offchain/contract/index.d.ts"
      ]
    }
  },
  "scripts": {
    "contract": "npm run compact",
    "compact": "compact compile src/hello-verifier.compact src/managed/hello-verifier && compact compile src/hello-verifier-offchain.compact src/managed/hello-verifier-offchain && compact compile src/dummy-claims-verifier.compact src/managed/dummy-claims-verifier && node ./scripts/align-runtime-version.mjs && node ./scripts/strip-managed-sourcemaps.mjs",
    "prepare:credential-families": "npm --prefix ../../../../packages/prototypes/credential-families/hello-family run build && npm --prefix ../../../../packages/prototypes/credential-families/dummy-claims run build",
    "prebuild": "npm run prepare:credential-families",
    "pretypecheck": "npm run prepare:credential-families",
    "pretest": "npm run prepare:credential-families && npm run compact",
    "test": "vitest run",
    "pretest:ci": "npm run prepare:credential-families && npm run compact",
    "test:ci": "vitest run",
    "prepack": "npm run build",
    "clean": "rm -rf dist && rm -rf coverage && rm -rf reports && rm -rf src/managed",
    "build": "npm run compact && rm -rf dist && mkdir -p dist/managed && tsc -b tsconfig.build.json --force && cp -Rf ./src/managed/. ./dist/managed/ && cp ./src/hello-verifier.compact ./src/hello-verifier-offchain.compact ./src/dummy-claims-verifier.compact ./dist",
    "lint": "eslint src --ignore-pattern 'src/managed/**'",
    "lint:fix": "eslint src --fix --ignore-pattern 'src/managed/**'",
    "typecheck": "npm run compact && tsc -p tsconfig.json --noEmit",
    "all": "npm run compact && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "*",
    "@midnight-ntwrk/midnight-did-credentials": "*",
    "@midnight-ntwrk/midnight-did-credentials-dummy-claims": "*",
    "@midnight-ntwrk/midnight-did-credentials-hello-family": "*"
  },
  "files": [
    "dist/**",
    "src/**/*.compact",
    "README.md",
    "scripts/*.mjs",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ]
}
