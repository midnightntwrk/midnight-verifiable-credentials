pragma language_version >= 0.20;

import CompactStandardLibrary;

include "../../../../../packages/prototypes/credential-families/hello-family/src/hello-family-offchain-credential";

export ledger contractVersion: Uint<32>;
export ledger successfulVerificationCount: Counter;
export ledger lastVerifiedCredentialRoot: Bytes<32>;
export ledger lastVerifiedRequestChallenge: Bytes<32>;
export ledger lastVerifiedBooleanValue: Boolean;
export ledger lastVerifiedBigUnsignedValue: Uint<248>;
export ledger lastVerifiedBytesValue: Bytes<32>;

constructor() {
  contractVersion = 1;
  lastVerifiedCredentialRoot = pad(32, "hello-verifier:none");
  lastVerifiedRequestChallenge = pad(32, "hello-verifier:no-request");
  lastVerifiedBooleanValue = false;
  lastVerifiedBigUnsignedValue = 0;
  lastVerifiedBytesValue = pad(32, "");
}

// Request-builder helper for the smallest verifier starter.
// This surface is pure because the starter policy is fully caller-supplied.
export pure circuit helloVerifierRequest(
  issuerVerificationMethodRef: VerificationMethodRef,
  verifierChallengeHash: Bytes<32>,
  requireBytesValueDisclosure: Boolean
): HelloFamilyPresentationRequest {
  return HelloFamilyPresentationRequest {
    version: 1,
    schema: SchemaRef {
      packageId: pad(32, "midnight:vc:hello-family"),
      schemaId: pad(32, "hello-family:v1"),
      majorVersion: 1,
      minorVersion: 0,
    },
    issuerVerificationMethodRef: issuerVerificationMethodRef,
    requireBooleanValueDisclosure: true,
    requireBytesValueDisclosure: requireBytesValueDisclosure,
    requireBigUnsignedValueDisclosure: true,
    verifierChallengeHash: verifierChallengeHash,
  };
}

// TRUST BOUNDARY: this starter demonstrates the runtime handoff from an
// offchain Midnight DID into a typed VC holder binding. It does not add status,
// external time binding, or durable business-capability semantics.
export circuit verifyHelloFamilyOffchainPresentationForHelloVerifier(
  credential: HelloFamilyOffchainCredential,
  credentialProof: Proof,
  request: HelloFamilyPresentationRequest,
  presentation: HelloFamilyOffchainPresentation,
  presentationProof: Proof
): [] {
  // CONFORMANCE LOCK: keep this verifier-side acceptance shape aligned with
  // the explicit hello-verifier starter so the DID-aware path stays a holder-
  // binding swap rather than a separate business-policy contract.
  const credentialRoot = disclose(
    helloFamilyOffchainCredentialBodyRoot(credential)
  );

  assert(
    request.requireBooleanValueDisclosure,
    "Hello-verifier starter requires boolean disclosure"
  );
  assert(
    request.requireBigUnsignedValueDisclosure,
    "Hello-verifier starter requires big-unsigned disclosure"
  );

  assertHelloFamilyOffchainPresentationSatisfiesRequest(
    credential,
    credentialProof,
    request,
    presentation,
    presentationProof
  );

  lastVerifiedCredentialRoot = credentialRoot;
  lastVerifiedRequestChallenge = disclose(request.verifierChallengeHash);
  // CONFORMANCE LOCK: this circuit enforces boolean and bigUnsigned disclosure
  // as an invariant, so they do not need a conditional reset path.
  lastVerifiedBooleanValue = disclose(presentation.disclosed.booleanValue);
  lastVerifiedBigUnsignedValue = disclose(
    presentation.disclosed.bigUnsignedValue
  );
  const revealedBytesValue = disclose(presentation.disclosed.revealBytesValue);

  if (revealedBytesValue) {
    lastVerifiedBytesValue = disclose(presentation.disclosed.bytesValue);
  } else {
    lastVerifiedBytesValue = pad(32, "");
  }

  successfulVerificationCount.increment(1);
}
