{
  "name": "@midnight-ntwrk/midnight-did-credentials-demo-contract",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "require": "./dist/contract.js",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./contract-revocation": {
      "types": "./dist/contract-revocation.d.ts",
      "require": "./dist/contract-revocation.js",
      "import": "./dist/contract-revocation.js",
      "default": "./dist/contract-revocation.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "require": "./dist/testing.js",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./managed/demo/contract/index.js": {
      "types": "./dist/managed/demo/contract/index.d.ts",
      "import": "./dist/managed/demo/contract/index.js",
      "default": "./dist/managed/demo/contract/index.js"
    },
    "./managed/demo-revocation/contract/index.js": {
      "types": "./dist/managed/demo-revocation/contract/index.d.ts",
      "import": "./dist/managed/demo-revocation/contract/index.js",
      "default": "./dist/managed/demo-revocation/contract/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "contract": [
        "dist/contract.d.ts"
      ],
      "contract-revocation": [
        "dist/contract-revocation.d.ts"
      ],
      "testing": [
        "dist/testing.d.ts"
      ],
      "managed/demo/contract/index.js": [
        "dist/managed/demo/contract/index.d.ts"
      ],
      "managed/demo-revocation/contract/index.js": [
        "dist/managed/demo-revocation/contract/index.d.ts"
      ]
    }
  },
  "scripts": {
    "prepare:status-registry": "pnpm --dir ../../../../packages/registry/status-registry run build",
    "contract": "pnpm run compact",
    "compact": "pnpm run compact:demo && pnpm run compact:demo-revocation && node ./scripts/align-runtime-version.mjs && node ./scripts/strip-managed-sourcemaps.mjs",
    "compact:demo": "node ../../../../tooling/scripts/ensure-compact-artifacts.mjs --manifest src/managed/.compact-artifact.json --source-root src --output src/managed/demo --output src/managed/demo-revocation -- sh -c \"compact compile src/demo.compact src/managed/demo && compact compile src/demo-revocation.compact src/managed/demo-revocation\"",
    "compact:demo-revocation": "node ../../../../tooling/scripts/ensure-compact-artifacts.mjs --manifest src/managed/.compact-artifact.json --source-root src --output src/managed/demo --output src/managed/demo-revocation -- sh -c \"compact compile src/demo.compact src/managed/demo && compact compile src/demo-revocation.compact src/managed/demo-revocation\"",
    "prebuild": "pnpm run prepare:status-registry",
    "pretypecheck": "pnpm run prepare:status-registry",
    "pretest": "pnpm run prepare:status-registry && pnpm run compact",
    "test": "vitest run --exclude src/test/integration/**/*.test.ts",
    "pretest:ci": "pnpm run prepare:status-registry && pnpm run compact",
    "test:integration": "vitest run --dir src/test/integration",
    "test:ci": "vitest run --exclude src/test/integration/**/*.test.ts",
    "prepack": "pnpm run build",
    "clean": "rm -rf dist && rm -rf coverage && rm -rf reports && rm -rf src/managed",
    "build": "pnpm run compact && rm -rf dist && tsc -b tsconfig.build.json --force && mkdir -p dist && cp -Rf ./src/managed ./dist/ && rm -f ./dist/managed/.compact-artifact.json && cp ./src/demo.compact ./dist && cp ./src/demo-revocation.compact ./dist",
    "lint": "eslint src --ignore-pattern 'src/managed/**'",
    "lint:fix": "eslint src --fix --ignore-pattern 'src/managed/**'",
    "typecheck": "pnpm run compact && tsc -p tsconfig.json --noEmit",
    "all": "pnpm run compact && pnpm run build && pnpm run test:ci"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "*",
    "@midnight-ntwrk/midnight-did-credentials": "*",
    "@midnight-ntwrk/midnight-did-credentials-birth": "*",
    "@midnight-ntwrk/midnight-did-credentials-birth-secret": "*",
    "@midnight-ntwrk/midnight-did-credentials-status-registry": "*",
    "@midnight-ntwrk/midnight-did-standalone-environment": "*"
  },
  "files": [
    "dist/**",
    "src/**/*.compact",
    "README.md",
    "scripts/*.mjs",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "midnight": {
    "maturity": "demo",
    "packageClass": "dist"
  }
}
