  opening: Bytes<32>
): Bytes<32> {
  return persistentCommit<Bytes<32>>(graduateName, opening);
}

export pure circuit universityDiplomaFacultyNameCommitment(
  facultyName: Bytes<32>,
  opening: Bytes<32>
): Bytes<32> {
  return persistentCommit<Bytes<32>>(facultyName, opening);
}

export pure circuit universityDiplomaHonorsCodeCommitment(
  honorsCode: Bytes<16>,
  opening: Bytes<32>
): Bytes<32> {
  return persistentCommit<Bytes<16>>(honorsCode, opening);
}

export pure circuit universityDiplomaGraduationMonthCommitment(
  graduationMonth: Uint<8>,
  opening: Bytes<32>
): Bytes<32> {
  return persistentCommit<Uint<8>>(graduationMonth, opening);
}

export pure circuit universityDiplomaFinalGradeCommitment(
