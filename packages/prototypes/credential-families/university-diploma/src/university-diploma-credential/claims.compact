// University-diploma direct claims.
// NOTE: human-readable text still has to be modeled as fixed-width Bytes<N>
// because Compact does not yet support a first-class String claim type.
export struct UniversityDiplomaClaims {
  diplomaId: Bytes<32>,
  studentId: Bytes<16>,
  graduateName: Bytes<32>,
  universityName: Bytes<32>,
  facultyName: Bytes<32>,
  awardName: Bytes<32>,
  honorsCode: Bytes<16>,
  graduationYear: Uint<16>,
  graduationMonth: Uint<8>,
  finalGrade: Uint<8>,
  creditsEarned: Uint<16>,
}

export pure circuit universityDiplomaClaimPayloadRoot(
  claims: UniversityDiplomaClaims
): Bytes<32> {
  return persistentHash<UniversityDiplomaClaims>(claims);
}

export pure circuit universityDiplomaClaimRoot(
  claims: UniversityDiplomaClaims
): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight:vc:uni-diploma:v1"),
    universityDiplomaClaimPayloadRoot(claims)
  ]);
}

// Production privacy profile building blocks.
// The current `UniversityDiplomaClaims` type remains a direct-claim prototype.
// These structs define the intended committed/private field split for the next
// university credential profile without changing the readable prototype shape.
export struct UniversityDiplomaProductionPublicClaims {
  universityName: Bytes<32>,
  awardName: Bytes<32>,
  graduationYear: Uint<16>,
}

export struct UniversityDiplomaClaimCommitments {
  diplomaIdCommitment: Bytes<32>,
  studentIdCommitment: Bytes<32>,
  graduateNameCommitment: Bytes<32>,
  facultyNameCommitment: Bytes<32>,
  honorsCodeCommitment: Bytes<32>,
  graduationMonthCommitment: Bytes<32>,
  finalGradeCommitment: Bytes<32>,
  creditsEarnedCommitment: Bytes<32>,
}

export pure circuit universityDiplomaProductionPublicClaimsRoot(
  publicClaims: UniversityDiplomaProductionPublicClaims
): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight:vc:uni-diploma:public"),
    persistentHash<UniversityDiplomaProductionPublicClaims>(publicClaims)
  ]);
}

export pure circuit universityDiplomaClaimCommitmentsRoot(
  claimCommitments: UniversityDiplomaClaimCommitments
): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight:vc:uni-diploma:private"),
    persistentHash<UniversityDiplomaClaimCommitments>(claimCommitments)
  ]);
}

export pure circuit universityDiplomaProductionClaimRoot(
  publicClaims: UniversityDiplomaProductionPublicClaims,
  claimCommitments: UniversityDiplomaClaimCommitments
): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "midnight:vc:uni-diploma:v2"),
    universityDiplomaProductionPublicClaimsRoot(publicClaims),
    universityDiplomaClaimCommitmentsRoot(claimCommitments)
  ]);
}

export pure circuit universityDiplomaIdCommitment(
  diplomaId: Bytes<32>,
  opening: Bytes<32>
): Bytes<32> {
  return persistentCommit<Bytes<32>>(diplomaId, opening);
}

export pure circuit universityDiplomaStudentIdCommitment(
  studentId: Bytes<16>,
  opening: Bytes<32>
): Bytes<32> {
  return persistentCommit<Bytes<16>>(studentId, opening);
}

export pure circuit universityDiplomaGraduateNameCommitment(
