export struct PassportKycIssuanceOfferBody {
  supportsExpiration: Boolean,
  defaultExpirationDays: Uint<16>,
  requiresHolderPublicKey: Boolean,
}

export struct PassportKycIssuanceRequestBody {
  holderBinding: ExplicitHolderBinding,
  holderPublicKey: JubjubPoint,
  holderChallengeHash: Bytes<32>,
  requestExpiration: Boolean,
  requestedExpirationDays: Uint<16>,
}

export struct PassportKycIssuanceResultBody {
  credential: PassportKycCredential,
  credentialProof: Proof,
  holderPublicKey: JubjubPoint,
  issuanceChallengeHash: Bytes<32>,
}

export struct PassportKycVerificationRequestBody {
  requireFirstNameDisclosure: Boolean,
  requireLastNameDisclosure: Boolean,
  requireAgeOverThreshold: Boolean,
  requestedAgeThresholdYears: Uint<8>,
}

export struct PassportKycVerificationSubmissionBody {
  credential: PassportKycCredential,
  credentialProof: Proof,
  presentation: PassportKycPresentation,
  presentationProof: Proof,
}

export struct PassportKycVerificationResultBody {
  credentialRoot: Bytes<32>,
  verifiedThresholdYears: Uint<8>,
}
