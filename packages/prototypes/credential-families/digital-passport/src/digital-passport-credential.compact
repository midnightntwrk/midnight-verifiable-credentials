pragma language_version >= 0.20;

import CompactStandardLibrary;

include "../../../../../packages/core/primitives/credentials/src/credentials";

include "./digital-passport-credential/claims";

include "./digital-passport-credential/model";

import VC<NoPublicClaims, DigitalPassportClaimCommitments, ExplicitHolderBinding, NoStatusBinding>;

import VP<DigitalPassportDisclosures, ExplicitHolderBinding>;

import CredentialPresentationRelations<NoPublicClaims,
                                       DigitalPassportClaimCommitments,
                                       DigitalPassportDisclosures,
                                       ExplicitHolderBinding,
                                       NoStatusBinding>
    prefix DigitalPassportPresentation_;

export type DigitalPassportCredential = Credential;

export type DigitalPassportPresentation = Presentation;

include "./digital-passport-credential/protocol-model";

import Issue<DigitalPassportIssuanceOfferBody,
             DigitalPassportIssuanceRequestBody,
             DigitalPassportIssuanceResultBody>
    prefix DigitalPassportIssuance_;

import Present<DigitalPassportVerificationRequestBody,
               DigitalPassportVerificationSubmissionBody,
               DigitalPassportVerificationResultBody>
    prefix DigitalPassportVerification_;

export type DigitalPassportIssuanceOffer = DigitalPassportIssuance_OfferMessage;

export type DigitalPassportIssuanceRequest = DigitalPassportIssuance_RequestMessage;

export type DigitalPassportIssuanceResult = DigitalPassportIssuance_ResultMessage;

export type DigitalPassportVerificationRequest = DigitalPassportVerification_RequestMessage;

export type DigitalPassportVerificationSubmission = DigitalPassportVerification_SubmissionMessage;

export type DigitalPassportVerificationResult = DigitalPassportVerification_ResultMessage;

include "./digital-passport-credential/helpers";

include "./digital-passport-credential/validation";
