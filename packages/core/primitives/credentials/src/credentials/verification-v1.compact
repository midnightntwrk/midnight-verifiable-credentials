export pure circuit assertValidActionHolderBindingV1(
  binding: ActionHolderBindingV1,
  expectedDeploymentDigest: Bytes<32>,
  expectedVerifierContractDigest: Bytes<32>,
  expectedActionClassDigest: Bytes<32>
): [] {
  assert(binding.domain == actionHolderBindingDomainV1(), "Action holder binding domain is unknown");
  assert(binding.version == 1, "Action holder binding version must be 1");
  assert(binding.deploymentDigest == expectedDeploymentDigest, "Action holder deployment binding mismatch");
  assert(binding.verifierContractDigest == expectedVerifierContractDigest, "Action holder verifier binding mismatch");
  assert(binding.actionClassDigest == expectedActionClassDigest, "Action holder action binding mismatch");
  assert(binding.holderSubjectDigest != pad(32, ""), "Action holder subject binding must be set");
}

export pure circuit assertValidActionCredentialBindingV1(
  binding: ActionCredentialBindingV1,
  expectedDeploymentDigest: Bytes<32>,
  expectedVerifierContractDigest: Bytes<32>,
  expectedActionClassDigest: Bytes<32>
): [] {
  assert(binding.domain == actionCredentialBindingDomainV1(), "Action credential binding domain is unknown");
  assert(binding.version == 1, "Action credential binding version must be 1");
  assert(binding.deploymentDigest == expectedDeploymentDigest, "Action credential deployment binding mismatch");
  assert(binding.verifierContractDigest == expectedVerifierContractDigest, "Action credential verifier binding mismatch");
  assert(binding.actionClassDigest == expectedActionClassDigest, "Action credential action binding mismatch");
  assert(binding.credentialFamilyDigest != pad(32, ""), "Action credential family binding must be set");
  assert(binding.schemaDigest != pad(32, ""), "Action credential schema binding must be set");
  assert(binding.credentialRoot != pad(32, ""), "Action credential root binding must be set");
}

export pure circuit assertValidRequestReplayScopeV1(
  scope: RequestReplayScopeV1,
  expectedDeploymentDigest: Bytes<32>,
  expectedVerifierContractDigest: Bytes<32>
): [] {
  assert(scope.domain == replayScopeRequestDomainV1(), "Request replay scope domain is unknown");
  assert(scope.version == 1, "Request replay scope version must be 1");
  assert(scope.deploymentDigest == expectedDeploymentDigest, "Request replay deployment binding mismatch");
  assert(scope.verifierContractDigest == expectedVerifierContractDigest, "Request replay verifier binding mismatch");
  assert(scope.requestIdDigest != pad(32, ""), "Request replay request id must be set");
  assert(scope.challengeDigest != pad(32, ""), "Request replay challenge must be set");
  assert(scope.actionInvocationDigest != pad(32, ""), "Request replay action invocation must be set");
}

export pure circuit assertValidHolderActionReplayScopeV1(
  scope: HolderActionReplayScopeV1,
  expectedDeploymentDigest: Bytes<32>,
  expectedVerifierContractDigest: Bytes<32>
): [] {
  assert(scope.domain == replayScopeHolderActionDomainV1(), "Holder-action replay scope domain is unknown");
  assert(scope.version == 1, "Holder-action replay scope version must be 1");
  assert(scope.deploymentDigest == expectedDeploymentDigest, "Holder-action deployment binding mismatch");
  assert(scope.verifierContractDigest == expectedVerifierContractDigest, "Holder-action verifier binding mismatch");
  assert(scope.actionClassDigest != pad(32, ""), "Holder-action class must be set");
  assert(scope.actionScopeParametersDigest != pad(32, ""), "Holder-action scope parameters must be set");
  assertValidActionHolderBindingV1(scope.binding, expectedDeploymentDigest, expectedVerifierContractDigest, scope.actionClassDigest);
}

export pure circuit assertValidCredentialActionReplayScopeV1(
  scope: CredentialActionReplayScopeV1,
  expectedDeploymentDigest: Bytes<32>,
  expectedVerifierContractDigest: Bytes<32>
): [] {
  assert(scope.domain == replayScopeCredentialActionDomainV1(), "Credential-action replay scope domain is unknown");
  assert(scope.version == 1, "Credential-action replay scope version must be 1");
  assert(scope.deploymentDigest == expectedDeploymentDigest, "Credential-action deployment binding mismatch");
  assert(scope.verifierContractDigest == expectedVerifierContractDigest, "Credential-action verifier binding mismatch");
  assert(scope.actionClassDigest != pad(32, ""), "Credential-action class must be set");
  assert(scope.actionScopeParametersDigest != pad(32, ""), "Credential-action scope parameters must be set");
  assertValidActionCredentialBindingV1(scope.binding, expectedDeploymentDigest, expectedVerifierContractDigest, scope.actionClassDigest);
}

// These are policy-specific primitives, not final authoritative verifiers.
// A product/composing circuit must select one from its fixed policy configuration;
// callers cannot select a replay policy at runtime through these entrypoints.
export pure circuit assertValidDecisionNullifierContextV1(
  deploymentDigest: Bytes<32>,
  verifierContractDigest: Bytes<32>
): [] {
  assert(deploymentDigest != pad(32, ""), "Deployment digest must be set");
  assert(verifierContractDigest != pad(32, ""), "Verifier contract digest must be set");
}

export pure circuit deriveRequestDecisionNullifierV1(
  deploymentDigest: Bytes<32>,
  verifierContractDigest: Bytes<32>,
  scope: RequestReplayScopeV1
): Bytes<32> {
  assertValidDecisionNullifierContextV1(deploymentDigest, verifierContractDigest);
  assertValidRequestReplayScopeV1(scope, deploymentDigest, verifierContractDigest);
  return decisionNullifierMaterialV1Digest(DecisionNullifierMaterialV1 {
    domain: decisionNullifierDomainV1(),
    version: 1,
    deploymentDigest: deploymentDigest,
    verifierContractDigest: verifierContractDigest,
    replayPolicy: 1,
    replayScopeDigest: requestReplayScopeV1Digest(scope),
  });
}

export pure circuit deriveHolderActionDecisionNullifierV1(
  deploymentDigest: Bytes<32>,
  verifierContractDigest: Bytes<32>,
  scope: HolderActionReplayScopeV1
): Bytes<32> {
  assertValidDecisionNullifierContextV1(deploymentDigest, verifierContractDigest);
  assertValidHolderActionReplayScopeV1(scope, deploymentDigest, verifierContractDigest);
  return decisionNullifierMaterialV1Digest(DecisionNullifierMaterialV1 {
    domain: decisionNullifierDomainV1(),
    version: 1,
    deploymentDigest: deploymentDigest,
    verifierContractDigest: verifierContractDigest,
    replayPolicy: 2,
    replayScopeDigest: holderActionReplayScopeV1Digest(scope),
  });
}

export pure circuit deriveCredentialActionDecisionNullifierV1(
  deploymentDigest: Bytes<32>,
  verifierContractDigest: Bytes<32>,
  scope: CredentialActionReplayScopeV1
): Bytes<32> {
  assertValidDecisionNullifierContextV1(deploymentDigest, verifierContractDigest);
  assertValidCredentialActionReplayScopeV1(scope, deploymentDigest, verifierContractDigest);
  return decisionNullifierMaterialV1Digest(DecisionNullifierMaterialV1 {
    domain: decisionNullifierDomainV1(),
    version: 1,
    deploymentDigest: deploymentDigest,
    verifierContractDigest: verifierContractDigest,
    replayPolicy: 3,
    replayScopeDigest: credentialActionReplayScopeV1Digest(scope),
  });
}

export pure circuit deriveNoDecisionNullifierV1(): Bytes<32> {
  return pad(32, "") as Bytes<32>;
}

export pure circuit syntheticVerificationExtensionV1Digest(
  extension: SyntheticVerificationExtensionV1
): Bytes<32> {
  return persistentHash<SyntheticVerificationExtensionV1>(extension);
}

export pure circuit verificationTranscriptV1Digest(
  transcript: VerificationTranscriptV1
): Bytes<32> {
  return persistentHash<VerificationTranscriptV1>(transcript);
}

export pure circuit assertValidEvidenceBindingV1(
  binding: EvidenceBindingV1,
  expectedDomain: Bytes<32>
): [] {
  assert(binding.domain == expectedDomain, "Evidence domain does not match its class");
  assert(binding.version == 1, "Evidence version must be 1");
  assert(binding.mode <= 4, "Evidence mode is unknown");

  if (binding.mode == 0) {
    assert(binding.authorityDigest == pad(32, ""), "Not-required evidence authority must be zero");
    assert(binding.subjectDigest == pad(32, ""), "Not-required evidence subject must be zero");
    assert(binding.stateAnchorDigest == pad(32, ""), "Not-required evidence anchor must be zero");
    assert(binding.statementDigest == pad(32, ""), "Not-required evidence statement must be zero");
    assert(binding.createdAt == 0, "Not-required evidence creation time must be zero");
    assert(binding.expiresAt == 0, "Not-required evidence expiry must be zero");
  }

  if (binding.mode == 1) {
    assert(binding.authorityDigest == pad(32, ""), "Unavailable evidence authority must be zero");
    assert(binding.subjectDigest != pad(32, ""), "Unavailable evidence subject must be scoped");
    assert(binding.stateAnchorDigest == pad(32, ""), "Unavailable evidence anchor must be zero");
    assert(binding.statementDigest == pad(32, ""), "Unavailable evidence statement must be zero");
    assert(binding.createdAt == 0, "Unavailable evidence creation time must be zero");
    assert(binding.expiresAt == 0, "Unavailable evidence expiry must be zero");
  }

  if (binding.mode >= 2) {
    assert(binding.authorityDigest != pad(32, ""), "Accepted evidence authority must be set");
    assert(binding.subjectDigest != pad(32, ""), "Accepted evidence subject must be set");
    assert(binding.stateAnchorDigest != pad(32, ""), "Accepted evidence anchor must be set");
    assert(binding.statementDigest != pad(32, ""), "Accepted evidence statement must be set");
    assert(binding.expiresAt > 0, "Accepted evidence expiry must be set");
    assert(binding.createdAt <= binding.expiresAt, "Evidence interval must be ordered");
  }
}

export pure circuit assertValidVerificationTranscriptV1(
  transcript: VerificationTranscriptV1
): [] {
  assert(transcript.domain == verificationTranscriptDomainV1(), "Transcript domain must be V1");
  assert(transcript.version == 1, "Transcript version must be 1");
  assert(transcript.profile >= 1 && transcript.profile <= 3, "Verification profile is unknown");
  assert(transcript.authority >= 1 && transcript.authority <= 3, "Verification authority is unknown");
  assert(transcript.credentialBindingMode >= 1 && transcript.credentialBindingMode <= 2, "Credential binding mode is unknown");
  assert(transcript.originMode <= 2, "Origin mode is unknown");
  assert(transcript.issuerRelationship >= 1 && transcript.issuerRelationship <= 3, "Issuer relationship is unknown");
  assert(transcript.statusMode <= 3, "Status mode is unknown");
  assert(transcript.timeMode <= 2, "Time mode is unknown");
  assert(transcript.nullifierMode <= 1, "Nullifier mode is unknown");
  assert(transcript.replayPolicy <= 3, "Replay policy is unknown");

  if (transcript.profile == 1) {
    assert(transcript.authority == 1, "Ledger-local profile requires ledger-local target authority");
    assert(transcript.originMode == 0, "Ledger-local profile cannot claim browser origin authority");
  }
  if (transcript.profile == 2) {
    assert(transcript.authority == 2, "Ledger-attested profile requires ledger-attested target authority");
    assert(transcript.originMode <= 1, "Ledger-attested origin must be none or wallet-attested");
  }
  if (transcript.profile == 3) {
    assert(transcript.authority == 3, "Off-chain profile requires local-process authority");
    assert(transcript.originMode == 0 || transcript.originMode == 2, "Off-chain origin must be none or local-request");
  }

  if (transcript.originMode == 0) {
    assert(transcript.originDigest == pad(32, ""), "No-origin digest must be zero");
  } else {
    assert(transcript.originDigest != pad(32, ""), "Enabled origin digest must be set");
  }

  assert(transcript.networkIdDigest != pad(32, ""), "Network digest must be set");
  assert(transcript.verifierContractDigest != pad(32, ""), "Verifier contract digest must be set");
  assert(transcript.deploymentDigest != pad(32, ""), "Deployment digest must be set");
  assert(transcript.audienceDigest != pad(32, ""), "Audience digest must be set");
  assert(transcript.connectorEvidenceDigest != pad(32, ""), "Connector evidence digest must be set");
  assert(transcript.requestIdDigest != pad(32, ""), "Request id digest must be set");
  assert(transcript.challengeDigest != pad(32, ""), "Challenge digest must be set");
  assert(transcript.expiresAt > 0, "Transcript expiry must be set");
  assert(transcript.credentialFamilyDigest != pad(32, ""), "Credential family digest must be set");
  assert(transcript.schemaDigest != pad(32, ""), "Schema digest must be set");
  assert(transcript.credentialBindingDigest != pad(32, ""), "Credential binding digest must be set");
  assert(transcript.disclosureDigest != pad(32, ""), "Disclosure digest must be set");
  assert(transcript.predicateDigest != pad(32, ""), "Predicate digest must be set");
  assert(transcript.holderBindingDigest != pad(32, ""), "Holder binding digest must be set");
  assert(transcript.policyDigest != pad(32, ""), "Policy digest must be set");
  assert(transcript.consentDigest != pad(32, ""), "Consent digest must be set");
  assert(transcript.presentationBindingDigest != pad(32, ""), "Presentation binding digest must be set");
  assert(transcript.issuerDidDigest != pad(32, ""), "Issuer DID digest must be set");
  assert(transcript.issuerMethodDigest != pad(32, ""), "Issuer method digest must be set");
  assert(transcript.issuerEvidenceDigest != pad(32, ""), "Issuer evidence digest must be set");
  assert(transcript.trustScopeDigest != pad(32, ""), "Trust scope digest must be set");
  assert(transcript.trustEvidenceDigest != pad(32, ""), "Trust evidence digest must be set");
  assert(transcript.statusEvidenceDigest != pad(32, ""), "Status evidence digest must be set");
  assert(transcript.timeEvidenceDigest != pad(32, ""), "Time evidence digest must be set");
  assert(transcript.artifactManifestDigest != pad(32, ""), "Artifact manifest digest must be set");
  assert(transcript.artifactEvidenceDigest != pad(32, ""), "Artifact evidence digest must be set");

  if (transcript.statusMode == 0) {
    assert(transcript.statusRegistryDigest == pad(32, ""), "No-status registry must be zero");
    assert(transcript.statusRoot == pad(32, ""), "No-status root must be zero");
    assert(transcript.statusRegistryVersion == 0, "No-status registry version must be zero");
    assert(transcript.statusFreshnessPolicyDigest == pad(32, ""), "No-status freshness policy must be zero");
  } else {
    assert(transcript.statusRegistryDigest != pad(32, ""), "Enabled status registry must be set");
    assert(transcript.statusRegistryVersion > 0, "Enabled status registry version must be positive");
    assert(transcript.statusFreshnessPolicyDigest != pad(32, ""), "Enabled status freshness policy must be set");
  }

  if (transcript.timeMode == 0) {
    assert(transcript.trustedTime == 0, "No-time mode requires zero trusted time");
  } else {
    assert(transcript.trustedTime > 0, "Enabled time mode requires trusted time");
  }

  if (transcript.nullifierMode == 0) {
    assert(transcript.replayPolicy == 0, "No-nullifier mode requires no replay policy");
    assert(transcript.actionClassDigest == pad(32, ""), "No-nullifier action class must be zero");
    assert(transcript.actionInvocationDigest == pad(32, ""), "No-nullifier action invocation must be zero");
    assert(transcript.replayScopeDigest == pad(32, ""), "No-nullifier replay scope must be zero");
    assert(transcript.decisionNullifier == pad(32, ""), "No-nullifier decision nullifier must be zero");
  } else {
    assert(transcript.profile != 3, "Off-chain verification cannot require a nullifier");
    assert(transcript.replayPolicy >= 1, "Required nullifier needs a replay policy");
    assert(transcript.actionClassDigest != pad(32, ""), "Required nullifier action class must be set");
    assert(transcript.actionInvocationDigest != pad(32, ""), "Required nullifier action invocation must be set");
    assert(transcript.replayScopeDigest != pad(32, ""), "Required nullifier replay scope must be set");
    assert(transcript.decisionNullifier != pad(32, ""), "Required decision nullifier must be set");
  }
}

export pure circuit assertValidVerificationPublicInputsV1(
  inputs: VerificationPublicInputsV1
): [] {
  assertValidVerificationTranscriptV1(inputs.transcript);
  assertValidEvidenceBindingV1(inputs.issuerEvidence, issuerEvidenceDomainV1());
  assertValidEvidenceBindingV1(inputs.trustEvidence, trustEvidenceDomainV1());
  assertValidEvidenceBindingV1(inputs.statusEvidence, statusEvidenceDomainV1());
  assertValidEvidenceBindingV1(inputs.timeEvidence, timeEvidenceDomainV1());
  assertValidEvidenceBindingV1(inputs.artifactEvidence, artifactEvidenceDomainV1());
  assertValidEvidenceBindingV1(inputs.connectorEvidence, connectorEvidenceDomainV1());

  assert(inputs.transcript.issuerEvidenceDigest == evidenceBindingV1Digest(inputs.issuerEvidence), "Issuer evidence digest mismatch");
  assert(inputs.transcript.trustEvidenceDigest == evidenceBindingV1Digest(inputs.trustEvidence), "Trust evidence digest mismatch");
  assert(inputs.transcript.statusEvidenceDigest == evidenceBindingV1Digest(inputs.statusEvidence), "Status evidence digest mismatch");
  assert(inputs.transcript.timeEvidenceDigest == evidenceBindingV1Digest(inputs.timeEvidence), "Time evidence digest mismatch");
  assert(inputs.transcript.artifactEvidenceDigest == evidenceBindingV1Digest(inputs.artifactEvidence), "Artifact evidence digest mismatch");
  assert(inputs.transcript.connectorEvidenceDigest == evidenceBindingV1Digest(inputs.connectorEvidence), "Connector evidence digest mismatch");

  if (inputs.transcript.statusMode == 0) {
    assert(inputs.statusEvidence.mode == 0, "No-status mode requires not-required status evidence");
  } else {
    assert(inputs.statusEvidence.mode != 0, "Enabled status mode requires status evidence");
  }
  if (inputs.transcript.timeMode == 0) {
    assert(inputs.timeEvidence.mode == 0, "No-time mode requires not-required time evidence");
  } else {
    assert(inputs.timeEvidence.mode != 0, "Enabled time mode requires time evidence");
  }
  if (inputs.transcript.originMode == 0 || inputs.transcript.originMode == 2) {
    assert(inputs.connectorEvidence.mode == 0, "Unattested origin requires not-required connector evidence");
  } else {
    assert(inputs.connectorEvidence.mode != 0, "Wallet-attested origin requires connector evidence");
  }
}

export pure circuit syntheticUnavailableAuthorityVerificationV1(
  inputs: VerificationPublicInputsV1,
  expectedTranscriptDigest: Bytes<32>
): SyntheticVerificationAttemptV1 {
  assertValidVerificationPublicInputsV1(inputs);
  const transcriptDigest: Bytes<32> = verificationTranscriptV1Digest(inputs.transcript);
  assert(transcriptDigest == expectedTranscriptDigest, "Transcript proof binding mismatch");
  assert(inputs.transcript.profile == 1 || inputs.transcript.profile == 2, "Synthetic authority fixture requires a ledger target profile");
  assert(
    inputs.issuerEvidence.mode == 1 ||
    inputs.trustEvidence.mode == 1 ||
    inputs.statusEvidence.mode == 1 ||
    inputs.timeEvidence.mode == 1 ||
    inputs.artifactEvidence.mode == 1 ||
    inputs.connectorEvidence.mode == 1,
    "Synthetic authority fixture requires unavailable evidence"
  );

  return SyntheticVerificationAttemptV1 {
    proofStatus: 2,
    decisionStatus: 0,
    authority: 3,
    executionStatus: 0,
    transcriptDigest: transcriptDigest,
  };
}
