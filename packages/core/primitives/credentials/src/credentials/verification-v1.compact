// Verification authority V1 public records and fail-closed wiring.
// Stateful replay protection and final authority adapters are intentionally
// owned by later verification-contract iterations.

export struct CredentialBindingV1 {
  domain: Bytes<32>,
  version: Uint<16>,
  mode: Uint<8>,
  credentialFamilyDigest: Bytes<32>,
  schemaDigest: Bytes<32>,
  verifierContractDigest: Bytes<32>,
  challengeDigest: Bytes<32>,
  credentialRoot: Bytes<32>,
}

