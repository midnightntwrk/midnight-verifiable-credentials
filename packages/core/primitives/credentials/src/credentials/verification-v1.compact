export pure circuit credentialBindingV1Digest(
  binding: CredentialBindingV1
): Bytes<32> {
  return persistentHash<CredentialBindingV1>(binding);
}

export pure circuit holderBindingV1Digest(
  binding: HolderBindingV1
): Bytes<32> {
  return persistentHash<HolderBindingV1>(binding);
}

export pure circuit consentBindingV1Digest(
  binding: ConsentBindingV1
): Bytes<32> {
  return persistentHash<ConsentBindingV1>(binding);
}

export pure circuit presentationBindingV1Digest(
  binding: PresentationBindingV1
): Bytes<32> {
  return persistentHash<PresentationBindingV1>(binding);
}

export pure circuit evidenceBindingV1Digest(
  binding: EvidenceBindingV1
): Bytes<32> {
  return persistentHash<EvidenceBindingV1>(binding);
}

export pure circuit anchorEvidenceReceiptV1Digest(
  receipt: AnchorEvidenceReceiptV1
): Bytes<32> {
  return persistentHash<AnchorEvidenceReceiptV1>(receipt);
}

export pure circuit decisionNullifierMaterialV1Digest(
  material: DecisionNullifierMaterialV1
): Bytes<32> {
  return persistentHash<DecisionNullifierMaterialV1>(material);
}

export pure circuit syntheticVerificationExtensionV1Digest(
  extension: SyntheticVerificationExtensionV1
): Bytes<32> {
