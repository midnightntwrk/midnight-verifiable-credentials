// Verification authority V1 public records and fail-closed wiring.
// Replay-scope/nullifier derivation is reusable here; persistent consumption is
// owned by the composing business contract. Final authority adapters remain a
// later verification-contract iteration.

export struct CredentialBindingV1 {
  domain: Bytes<32>,
  version: Uint<16>,
  mode: Uint<8>,
  credentialFamilyDigest: Bytes<32>,
  schemaDigest: Bytes<32>,
  verifierContractDigest: Bytes<32>,
  challengeDigest: Bytes<32>,
  credentialRoot: Bytes<32>,
}

