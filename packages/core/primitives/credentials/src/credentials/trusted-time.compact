// Comparison-only trusted-time primitives supported by the pinned Compact stack.
// A disclosed candidate remains untrusted until both ledger comparisons are
// asserted in the same protected transition.

circuit assertTrustedLedgerTimeV1(
  candidateSeconds: Uint<64>
): [] {
  assert(
    blockTimeGte(disclose(candidateSeconds)),
    "Trusted time candidate is in the future"
  );
  assert(
    blockTimeLte(disclose(candidateSeconds)),
    "Trusted time candidate is stale"
  );
}

circuit assertTrustedLedgerDayV1(
  candidateDay: Uint<32>
): [] {
  const startSeconds: Uint<64> = ((candidateDay as Field) * 86400) as Uint<64>;
  const endSeconds: Uint<64> = (((candidateDay as Field) + 1) * 86400) as Uint<64>;
  assert(
    blockTimeGte(disclose(startSeconds)),
    "Trusted day candidate is in the future"
  );
  assert(
    blockTimeLt(disclose(endSeconds)),
    "Trusted day candidate is stale"
  );
}

circuit assertTrustedLedgerIntervalV1(
  createdAtSeconds: Uint<64>,
  expiresAtSeconds: Uint<64>
): [] {
  assert(
    disclose(createdAtSeconds <= expiresAtSeconds),
    "Trusted time interval must be ordered"
  );
  assert(
    blockTimeGte(disclose(createdAtSeconds)),
    "Trusted time interval is not yet valid"
  );
  assert(
    blockTimeLte(disclose(expiresAtSeconds)),
    "Trusted time interval has expired"
  );
}
