// Bounded aggregate authority records for two or three Verification V1 results.
// This is an opt-in composition surface so unrelated credential families do not
// inherit aggregate circuits or artifact growth.

export struct AggregateChildDecisionBindingV1 {
  domain: Bytes<32>,
  version: Uint<16>,
  familyDigest: Bytes<32>,
  schemaDigest: Bytes<32>,
  transcriptDigest: Bytes<32>,
  anchorEvidenceDigest: Bytes<32>,
  issuerDidDigest: Bytes<32>,
  issuerMethodDigest: Bytes<32>,
  issuerRelationship: Uint<8>,
  issuerEvidenceDigest: Bytes<32>,
  trustScopeDigest: Bytes<32>,
  trustEvidenceDigest: Bytes<32>,
  statusMode: Uint<8>,
  statusRegistryDigest: Bytes<32>,
  statusRoot: Bytes<32>,
  statusRegistryVersion: Uint<64>,
  statusFreshnessPolicyDigest: Bytes<32>,
  statusEvidenceDigest: Bytes<32>,
  timeMode: Uint<8>,
  trustedTime: Uint<64>,
  timeEvidenceDigest: Bytes<32>,
  artifactManifestDigest: Bytes<32>,
  artifactEvidenceDigest: Bytes<32>,
  holderBindingDigest: Bytes<32>,
  profile: Uint<8>,
  resultKind: Uint<8>,
  proofStatus: Uint<8>,
  decisionStatus: Uint<8>,
  executionStatus: Uint<8>,
  authority: Uint<8>,
  decisionNullifier: Bytes<32>,
  transactionDigest: Bytes<32>,
  atomicMutation: Uint<8>,
}

export struct AggregateChildSetV1 {
  domain: Bytes<32>,
  version: Uint<16>,
  childCount: Uint<8>,
  firstChildDigest: Bytes<32>,
  secondChildDigest: Bytes<32>,
  thirdChildDigest: Bytes<32>,
}

export struct AggregateSameHolderBindingV1 {
  domain: Bytes<32>,
  version: Uint<16>,
  mode: Uint<8>,
  verifierContractDigest: Bytes<32>,
  challengeDigest: Bytes<32>,
  childCount: Uint<8>,
  firstHolderBindingDigest: Bytes<32>,
  secondHolderBindingDigest: Bytes<32>,
  thirdHolderBindingDigest: Bytes<32>,
  childSetDigest: Bytes<32>,
  proofDigest: Bytes<32>,
}

export struct AggregateRequestBindingV1 {
  domain: Bytes<32>,
  version: Uint<16>,
  networkIdDigest: Bytes<32>,
  verifierContractDigest: Bytes<32>,
  deploymentDigest: Bytes<32>,
  audienceDigest: Bytes<32>,
  requestIdDigest: Bytes<32>,
  challengeDigest: Bytes<32>,
  expiresAt: Uint<64>,
  policyDigest: Bytes<32>,
  actionClassDigest: Bytes<32>,
  actionInvocationDigest: Bytes<32>,
  replayPolicy: Uint<8>,
  replayScopeDigest: Bytes<32>,
}

export struct AggregateDecisionNullifierMaterialV1 {
  domain: Bytes<32>,
  version: Uint<16>,
  deploymentDigest: Bytes<32>,
  verifierContractDigest: Bytes<32>,
  requestBindingDigest: Bytes<32>,
  childSetDigest: Bytes<32>,
  actionClassDigest: Bytes<32>,
  actionInvocationDigest: Bytes<32>,
  replayPolicy: Uint<8>,
  replayScopeDigest: Bytes<32>,
  sameHolderBindingDigest: Bytes<32>,
  policyDigest: Bytes<32>,
}

export struct AggregateDecisionTranscriptV1 {
  domain: Bytes<32>,
  version: Uint<16>,
  authority: Uint<8>,
  childCount: Uint<8>,
  requestBindingDigest: Bytes<32>,
  childSetDigest: Bytes<32>,
  sameHolderBindingDigest: Bytes<32>,
  aggregateTrustedTime: Uint<64>,
  nullifierMode: Uint<8>,
  decisionNullifier: Bytes<32>,
}

export pure circuit aggregateChildDecisionBindingDomainV1(): Bytes<32> {
  return ([148, 20, 30, 32, 118, 193, 93, 42, 139, 115, 76, 98, 250, 221, 86, 32, 128, 105, 246, 47, 208, 104, 177, 144, 43, 252, 92, 79, 5, 144, 72, 73] as Bytes<32>);
}

export pure circuit aggregateChildSetDomainV1(): Bytes<32> {
  return ([163, 232, 37, 188, 111, 32, 145, 165, 250, 229, 121, 225, 77, 191, 137, 136, 43, 113, 144, 106, 126, 130, 145, 106, 215, 221, 10, 245, 133, 91, 112, 227] as Bytes<32>);
}

export pure circuit aggregateRequestBindingDomainV1(): Bytes<32> {
  return ([13, 132, 112, 83, 182, 17, 179, 85, 155, 81, 22, 99, 18, 11, 81, 174, 38, 16, 193, 134, 15, 88, 56, 237, 99, 81, 233, 1, 80, 250, 52, 123] as Bytes<32>);
}

export pure circuit aggregateSameHolderBindingDomainV1(): Bytes<32> {
  return ([254, 110, 78, 67, 171, 233, 198, 234, 122, 165, 14, 198, 45, 246, 221, 42, 219, 199, 73, 122, 194, 252, 22, 86, 40, 97, 21, 29, 185, 14, 189, 124] as Bytes<32>);
}

export pure circuit aggregateDecisionTranscriptDomainV1(): Bytes<32> {
  return ([152, 68, 248, 125, 191, 179, 155, 204, 85, 183, 164, 132, 31, 96, 72, 13, 161, 123, 157, 254, 198, 105, 44, 193, 114, 221, 144, 71, 119, 66, 24, 79] as Bytes<32>);
}

export pure circuit aggregateDecisionNullifierDomainV1(): Bytes<32> {
  return ([180, 78, 103, 246, 104, 233, 239, 33, 102, 36, 15, 209, 104, 32, 198, 140, 53, 102, 61, 207, 70, 181, 182, 201, 88, 57, 37, 241, 205, 127, 10, 156] as Bytes<32>);
}

export pure circuit aggregateChildDecisionBindingV1Digest(
  binding: AggregateChildDecisionBindingV1
): Bytes<32> {
  return persistentHash<AggregateChildDecisionBindingV1>(binding);
}

export pure circuit aggregateChildSetV1Digest(
  childSet: AggregateChildSetV1
): Bytes<32> {
  return persistentHash<AggregateChildSetV1>(childSet);
}

export pure circuit aggregateRequestBindingV1Digest(
  request: AggregateRequestBindingV1
): Bytes<32> {
  return persistentHash<AggregateRequestBindingV1>(request);
}

export pure circuit aggregateSameHolderBindingV1Digest(
  binding: AggregateSameHolderBindingV1
): Bytes<32> {
  return persistentHash<AggregateSameHolderBindingV1>(binding);
}

export pure circuit aggregateDecisionNullifierMaterialV1Digest(
  material: AggregateDecisionNullifierMaterialV1
): Bytes<32> {
  return persistentHash<AggregateDecisionNullifierMaterialV1>(material);
}

export pure circuit aggregateDecisionTranscriptV1Digest(
  transcript: AggregateDecisionTranscriptV1
): Bytes<32> {
  return persistentHash<AggregateDecisionTranscriptV1>(transcript);
}
