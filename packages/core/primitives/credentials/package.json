{
  "name": "@midnight-ntwrk/midnight-did-credentials",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "require": "./dist/contract.js",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./managed/credentials/contract/index.js": {
      "types": "./dist/managed/credentials/contract/index.d.ts",
      "import": "./dist/managed/credentials/contract/index.js",
      "default": "./dist/managed/credentials/contract/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "contract": [
        "dist/contract.d.ts"
      ],
      "managed/credentials/contract/index.js": [
        "dist/managed/credentials/contract/index.d.ts"
      ]
    }
  },
  "scripts": {
    "contract": "npm run compact",
    "compact": "compact compile src/credentials.compact src/managed/credentials && node ./scripts/align-runtime-version.mjs && node ./scripts/strip-managed-sourcemaps.mjs",
    "pretest": "npm run compact",
    "test": "vitest run",
    "pretest:ci": "npm run compact",
    "test:ci": "vitest run",
    "prepack": "npm run build",
    "clean": "rm -rf dist && rm -rf coverage && rm -rf reports && rm -rf src/managed",
    "build": "npm run compact && rm -rf dist && mkdir -p dist && tsc -b tsconfig.build.json --force && cp -Rf ./src/managed ./dist/ && cp ./src/credentials.compact ./dist && cp -Rf ./src/credentials ./dist/",
    "lint": "eslint src --ignore-pattern 'src/managed/**'",
    "lint:fix": "eslint src --fix --ignore-pattern 'src/managed/**'",
    "typecheck": "npm run compact && tsc -p tsconfig.json --noEmit",
    "all": "npm run compact && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "*"
  },
  "files": [
    "dist/**",
    "src/**/*.compact",
    "README.md",
    "scripts/*.mjs",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ]
}
