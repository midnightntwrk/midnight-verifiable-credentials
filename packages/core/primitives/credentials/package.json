{
  "name": "@midnight-ntwrk/midnight-did-credentials",
  "version": "0.1.0",
  "description": "Compact-first verifiable credential and presentation primitives for Midnight",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-verifiable-credentials.git",
    "directory": "packages/core/primitives/credentials"
  },
  "keywords": [
    "midnight",
    "verifiable-credentials",
    "zero-knowledge",
    "compact",
    "ssi"
  ],
  "sideEffects": [
    "./dist/managed/**/*.js"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./jubjub": {
      "types": "./dist/jubjub.d.ts",
      "import": "./dist/jubjub.js",
      "default": "./dist/jubjub.js"
    },
    "./credentials.compact": "./dist/credentials.compact",
    "./credentials/*.compact": "./dist/credentials/*.compact",
    "./managed/credentials/contract/index.js": {
      "types": "./dist/managed/credentials/contract/index.d.ts",
      "import": "./dist/managed/credentials/contract/index.js",
      "default": "./dist/managed/credentials/contract/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "contract": [
        "dist/contract.d.ts"
      ],
      "jubjub": [
        "dist/jubjub.d.ts"
      ],
      "managed/credentials/contract/index.js": [
        "dist/managed/credentials/contract/index.d.ts"
      ]
    }
  },
  "scripts": {
    "contract": "pnpm run compact",
    "compact": "node ../../../../tooling/scripts/ensure-compact-artifacts.mjs --manifest src/managed/.compact-artifact.json --source-root src --output src/managed/credentials --recipe-input scripts/strip-managed-sourcemaps.mjs -- sh -c \"compact compile src/credentials.compact src/managed/credentials && node ./scripts/strip-managed-sourcemaps.mjs\"",
    "pretest": "pnpm run compact",
    "test": "vitest run",
    "pretest:ci": "pnpm run compact",
    "test:ci": "vitest run",
    "prepack": "pnpm run build",
    "clean": "rm -rf dist && rm -rf coverage && rm -rf reports && rm -rf src/managed",
    "build": "pnpm run compact && rm -rf dist && mkdir -p dist && tsc -b tsconfig.build.json --force && cp -Rf ./src/managed ./dist/ && rm -f ./dist/managed/.compact-artifact.json && cp ./src/credentials.compact ./dist && cp -Rf ./src/credentials ./dist/",
    "lint": "eslint src --ignore-pattern 'src/managed/**'",
    "lint:fix": "eslint src --fix --ignore-pattern 'src/managed/**'",
    "typecheck": "pnpm run compact && tsc -p tsconfig.json --noEmit",
    "all": "pnpm run compact && pnpm run build && pnpm run test:ci"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.19.0"
  },
  "files": [
    "dist/**",
    "src/**/*.compact",
    "README.md",
    "CHANGELOG.md",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "midnight": {
    "maturity": "core",
    "packageClass": "dist"
  }
}
