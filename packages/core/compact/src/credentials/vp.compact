// Thin VP envelope surface.
// Owns presentation-local structure and body-root derivation. VC↔VP linkage
// and holder-binding equality stay outside this module.
module VP<TDisclosures, THolderBinding> {
  export struct Presentation {
    version: Uint<16>,
    schema: SchemaRef,
    credentialClaimRoot: Bytes<32>,
    issuerVerificationMethodRef: VerificationMethodRef,
    holderBinding: THolderBinding,
    disclosed: TDisclosures,
  }

  export pure circuit presentationBodyRoot(presentation: Presentation): Bytes<32> {
    return persistentHash<Presentation>(presentation);
  }

  export pure circuit assertValidPresentationEnvelope(
    presentation: Presentation
  ): [] {
    // VC/VP linkage now lives in `relations.compact`; the thin VP surface only
    // owns presentation-local envelope invariants.
    assert(presentation.version == 1, "Presentation version mismatch");
  }
}

// Canonical presentation-proof composition for the core's supported explicit
// holder profile. The credential binding is supplied separately so a
// presentation cannot select a different holder and then self-authenticate it.
module ExplicitHolderPresentationProof<TDisclosures> {
  import VP<TDisclosures, ExplicitHolderBinding> prefix ExplicitHolderVP_;

  export pure circuit assertValidPresentationProof(
    credentialHolderBinding: ExplicitHolderBinding,
    presentation: ExplicitHolderVP_Presentation,
    proof: Proof
  ): [] {
    const bodyRoot: Bytes<32> = ExplicitHolderVP_presentationBodyRoot(presentation);
    ExplicitHolderVP_assertValidPresentationEnvelope(presentation);
    assertMatchingExplicitHolderBindings(
      credentialHolderBinding,
      presentation.holderBinding
    );
    assertProofMatchesExplicitHolderBinding(presentation.holderBinding, proof);
    assertValidPresentationContextProof(bodyRoot, proof);
  }
}
