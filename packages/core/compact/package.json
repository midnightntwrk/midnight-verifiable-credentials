{
  "name": "@midnight-ntwrk/credential-compact",
  "version": "0.1.0",
  "description": "Private candidate library of family-neutral Compact VC and VP semantics",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-verifiable-credentials.git",
    "directory": "packages/core/compact"
  },
  "keywords": [
    "midnight",
    "verifiable-credentials",
    "compact",
    "vc",
    "vp"
  ],
  "sideEffects": [],
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./jubjub": {
      "types": "./dist/jubjub.d.ts",
      "import": "./dist/jubjub.js",
      "default": "./dist/jubjub.js"
    },
    "./credentials.compact": "./dist/credentials.compact",
    "./credentials/composable.compact": "./dist/credentials/composable.compact"
  },
  "scripts": {
    "check-toolchain": "node scripts/check-toolchain.mjs",
    "compact": "pnpm run check-toolchain && node scripts/remove-retired-same-holder-output.mjs && node ../../../tooling/scripts/ensure-compact-artifacts.mjs --manifest src/managed/.compact-artifact.json --source-root src --output src/managed/credentials -- sh -c \"compact compile src/credentials.compact src/managed/credentials && rm -rf src/managed/credentials/compiler\"",
    "build": "pnpm run compact && rm -rf dist && mkdir -p dist && tsc -b tsconfig.build.json --force && cp -Rf src/managed dist/ && rm -f dist/managed/.compact-artifact.json && cp src/credentials.compact dist/ && cp -Rf src/credentials dist/ && node scripts/write-build-manifest.mjs",
    "typecheck": "pnpm run compact && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ignore-pattern 'src/managed/**'",
    "test": "vitest run",
    "test:ci": "pnpm run compact && vitest run",
    "prepack": "pnpm run build",
    "clean": "rm -rf dist src/managed coverage reports *.tsbuildinfo"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "files": [
    "dist/**",
    "src/**/*.compact",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "midnight": {
    "maturity": "core",
    "packageClass": "dist",
    "releaseStage": "supported",
    "compactCompilerVersion": "0.31.1",
    "compactRuntimeVersion": "0.16.0",
    "compactSources": [
      "src/credentials.compact",
      "src/credentials/composable.compact",
      "src/credentials/holder-bindings.compact",
      "src/credentials/proofs.compact",
      "src/credentials/relations.compact",
      "src/credentials/status-bindings.compact",
      "src/credentials/types.compact",
      "src/credentials/vc.compact",
      "src/credentials/vp.compact"
    ],
    "compactEntrypoints": {
      "standalone": [
        "./credentials.compact"
      ],
      "composition": [
        "./credentials/composable.compact"
      ]
    }
  }
}
