{
  "name": "@midnight-ntwrk/midnight-did-credentials-protocol",
  "version": "0.1.0",
  "description": "Protocol simulation layer for Midnight Verifiable Credentials",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.build.json --force",
    "test": "vitest run",
    "test:ci": "pnpm run test",
    "test:integration": "node ./scripts/run-integration-tests.mjs",
    "lint": "eslint src --ext .ts --ignore-pattern src/managed/**",
    "lint:fix": "eslint src --ext .ts --ignore-pattern src/managed/** --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist && rm -rf coverage",
    "all": "pnpm run build && pnpm run test",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/credential-proofs": "*",
    "@midnight-ntwrk/midnight-did-credentials": "*",
    "@midnight-ntwrk/midnight-did-credentials-birth": "*",
    "@midnight-ntwrk/midnight-did-credentials-birth-secret": "*",
    "@midnight-ntwrk/midnight-did-credentials-demo-contract": "*",
    "@midnight-ntwrk/midnight-did-credentials-same-holder": "*",
    "@midnight-ntwrk/midnight-did-standalone-environment": "*"
  },
  "files": [
    "dist/**",
    "README.md",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "midnight": {
    "maturity": "infrastructure",
    "packageClass": "dist"
  }
}
