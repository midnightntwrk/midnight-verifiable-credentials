{
  "name": "@midnight-ntwrk/credential-exchange",
  "version": "0.1.0",
  "description": "Family-neutral issuance, presentation, and verification orchestration ports",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": [],
  "engines": { "node": ">=24", "pnpm": ">=10" },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist .cache && tsc -b tsconfig.build.json --force",
    "prepack": "pnpm run build",
    "test": "vitest run --config vitest.config.ts",
    "test:ci": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "clean": "rm -rf dist coverage .cache *.tsbuildinfo",
    "all": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test:ci"
  },
  "dependencies": {
    "@midnight-ntwrk/credential-model": "workspace:*",
    "@midnight-ntwrk/credential-proofs": "workspace:*"
  },
  "files": [
    "dist/**",
    "README.md",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "midnight": {
    "maturity": "infrastructure",
    "packageClass": "dist",
    "releaseStage": "internal"
  }
}
