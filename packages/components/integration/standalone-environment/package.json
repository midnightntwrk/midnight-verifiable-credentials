{
  "name": "@midnight-ntwrk/midnight-did-standalone-environment",
  "version": "0.1.0",
  "description": "Shared Midnight standalone environment for integration tests",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.19.0",
    "@midnight-ntwrk/midnight-did": "0.5.0",
    "@midnight-ntwrk/midnight-did-api": "0.5.0",
    "@midnight-ntwrk/midnight-did-contract": "0.5.0",
    "@midnight-ntwrk/midnight-did-domain": "0.5.0",
    "@midnight-ntwrk/midnight-did-jubjub-schnorr": "0.5.0",
    "@midnight-ntwrk/midnight-did-secret-storage": "file:../../../../tooling/vendor/midnight-did/midnight-ntwrk-midnight-did-secret-storage-0.1.0.tgz",
    "rxjs": "*",
    "testcontainers": "*"
  },
  "files": [
    "src/**/*.ts",
    "package.json",
    "tsconfig.json",
    "README.md"
  ],
  "midnight": {
    "maturity": "infrastructure",
    "packageClass": "source-only"
  }
}
