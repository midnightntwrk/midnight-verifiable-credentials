# Environment variables for the standalone indexer container.
# These are dev defaults for local use only.

# Docker Compose v2 interpolates this value; set NODE_WEBSOCKET_SCHEME=wss when TLS is available.
APP__INFRA__NODE__URL=${NODE_WEBSOCKET_SCHEME:-ws}://node:9944
APP__INFRA__STORAGE__PASSWORD=indexer
APP__INFRA__PUB_SUB__PASSWORD=indexer
APP__INFRA__LEDGER_STATE_STORAGE__PASSWORD=indexer
# StandaloneEnvironment supplies a deterministic non-secret key at startup.
APP__INFRA__SECRET=${INDEXER_DEVELOPMENT_KEY:?Set INDEXER_DEVELOPMENT_KEY for the standalone development stack}
