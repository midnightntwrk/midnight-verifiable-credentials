{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [".nvmrc"],
  "globalPassThroughEnv": ["COMPACT_DIRECTORY"],
  "tasks": {
    "clean": {
      "cache": false
    },
    "lint": {
      "env": [
        "CI"
      ],
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "CI"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "src/managed/**",
        "*.tsbuildinfo"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "CI"
      ],
      "outputs": []
    }
  }
}
