  assertValidRevokedSetNonMembershipStatusProofProtocol(
    statusInputs.statusProofProtocol
  );
}

export circuit assertValidSecretBirthCredentialVerificationLiveStatusInputs(
  statusInputs: SecretBirthCredentialVerificationLiveStatusInputs
): [] {
  assertValidLiveStatusWitnessInput(
    statusInputs.witnessInput
