  assertValidAuthorityAttestedStatusProofProtocol(
    statusInputs.statusProofProtocol
  );
}

export circuit assertSecretBirthCredentialVerificationSubmissionMatchesRevokedSetStatusRequest(
  credentialWithStatus: SecretBirthCredentialWithStatusBinding,
  request: SecretBirthCredentialVerificationRevokedSetStatusRequest,
  submission: SecretBirthCredentialVerificationSubmission,
  statusInputs: SecretBirthCredentialVerificationRevokedSetStatusInputs,
  holderSecret: Bytes<32>,
  holderSecretOpening: Bytes<32>,
  holderBindingBlindingFactor: Bytes<32>
): [] {
  const plainCredential = secretBirthCredentialWithoutStatusBinding(
    credentialWithStatus.credential
  );
  assertValidSecretBirthCredentialWithStatusBinding(credentialWithStatus);
  assertValidSecretBirthCredentialVerificationRevokedSetStatusRequest(request);
  assertValidSecretBirthCredentialVerificationRevokedSetStatusInputs(
    statusInputs
  );
  assert(
    secretBirthCredentialBodyRoot(submission.body.credential)
      == secretBirthCredentialBodyRoot(plainCredential),
    "Revoked-set status verification submission credential does not match the status-bound credential body"
  );
  assert(
    submission.body.credentialProof.challengeHash
      == credentialWithStatus.credentialProof.challengeHash,
    "Revoked-set status verification submission credential proof does not match the status-bound credential proof"
  );
  assertSecretBirthCredentialVerificationSubmissionMatchesRequest(
    request.verificationRequest,
    submission,
    holderSecret,
    holderSecretOpening,
    holderBindingBlindingFactor
  );
  assert(
    statusInputs.statusProofProtocol.request.verifierChallengeHash
      == request.verificationRequest.verifierChallengeHash,
    "Revoked-set status proof protocol challenge must match the verification request challenge"
  );
  assert(
    statusInputs.statusProofProtocol.request.registryState.registryId
      == request.statusRequest.registryState.registryId,
    "Revoked-set status proof protocol registry id does not match the verifier request"
  );
  assert(
    statusInputs.statusProofProtocol.request.registryState.revokedRoot
      == request.statusRequest.registryState.revokedRoot,
    "Revoked-set status proof protocol revoked root does not match the verifier request"
  );
  assert(
    statusInputs.statusProofProtocol.request.registryState.registryVersion
      == request.statusRequest.registryState.registryVersion,
    "Revoked-set status proof protocol registry version does not match the verifier request"
  );
  assertVerifierStatusPolicyAcceptsRevokedSetNonMembershipStatusProofProtocol(
    request.statusPolicy,
    credentialWithStatus.credential.statusBinding,
    statusInputs.statusProofProtocol
  );
}

export circuit assertSecretBirthCredentialVerificationSubmissionMatchesLiveStatusRequest(
  credentialWithStatus: SecretBirthCredentialWithStatusBinding,
  request: SecretBirthCredentialVerificationLiveStatusRequest,
  submission: SecretBirthCredentialVerificationSubmission,
  statusInputs: SecretBirthCredentialVerificationLiveStatusInputs,
  holderSecret: Bytes<32>,
  holderSecretOpening: Bytes<32>,
  holderBindingBlindingFactor: Bytes<32>
): [] {
  const plainCredential = secretBirthCredentialWithoutStatusBinding(
    credentialWithStatus.credential
  );
  assertValidSecretBirthCredentialWithStatusBinding(credentialWithStatus);
  assertValidSecretBirthCredentialVerificationLiveStatusRequest(request);
  assertValidSecretBirthCredentialVerificationLiveStatusInputs(
    statusInputs
  );
  assert(
    secretBirthCredentialBodyRoot(submission.body.credential)
      == secretBirthCredentialBodyRoot(plainCredential),
    "Live status verification submission credential does not match the status-bound credential body"
  );
  assert(
    submission.body.credentialProof.challengeHash
      == credentialWithStatus.credentialProof.challengeHash,
    "Live status verification submission credential proof does not match the status-bound credential proof"
  );
  assertSecretBirthCredentialVerificationSubmissionMatchesRequest(
    request.verificationRequest,
    submission,
    holderSecret,
    holderSecretOpening,
    holderBindingBlindingFactor
  );
  assertVerifierStatusPolicyAcceptsLiveStatusBinding(
    request.statusPolicy,
    credentialWithStatus.credential.statusBinding,
    statusInputs.witnessInput
  );
}

export circuit assertSecretBirthCredentialVerificationSubmissionMatchesAuthorityAttestedStatusProtocolRequest(
  credentialWithStatus: SecretBirthCredentialWithStatusBinding,
  request: SecretBirthCredentialVerificationAuthorityAttestedStatusRequest,
  submission: SecretBirthCredentialVerificationSubmission,
  statusInputs: SecretBirthCredentialVerificationAuthorityAttestedStatusProtocolInputs,
  holderSecret: Bytes<32>,
  holderSecretOpening: Bytes<32>,
  holderBindingBlindingFactor: Bytes<32>,
  currentTime: Uint<64>
): [] {
  const plainCredential = secretBirthCredentialWithoutStatusBinding(
    credentialWithStatus.credential
  );
  assertValidSecretBirthCredentialWithStatusBinding(credentialWithStatus);
  assertValidSecretBirthCredentialVerificationAuthorityAttestedStatusRequest(
    request
  );
  assertValidSecretBirthCredentialVerificationAuthorityAttestedStatusProtocolInputs(
    statusInputs
  );
  assert(
    secretBirthCredentialBodyRoot(submission.body.credential)
      == secretBirthCredentialBodyRoot(plainCredential),
    "Authority-attested status protocol submission credential does not match the status-bound credential body"
  );
  assert(
    submission.body.credentialProof.challengeHash
      == credentialWithStatus.credentialProof.challengeHash,
    "Authority-attested status protocol submission credential proof does not match the status-bound credential proof"
  );
  assertSecretBirthCredentialVerificationSubmissionMatchesRequest(
    request.verificationRequest,
    submission,
    holderSecret,
    holderSecretOpening,
    holderBindingBlindingFactor
  );
  assert(
    statusInputs.statusProofProtocol.request.registryState.registryId
      == request.statusRequest.registryState.registryId,
    "Authority-attested status proof protocol registry id does not match the verifier request"
  );
  assert(
    statusInputs.statusProofProtocol.request.registryState.revokedRoot
      == request.statusRequest.registryState.revokedRoot,
    "Authority-attested status proof protocol revoked root does not match the verifier request"
  );
  assert(
    statusInputs.statusProofProtocol.request.registryState.registryVersion
      == request.statusRequest.registryState.registryVersion,
    "Authority-attested status proof protocol registry version does not match the verifier request"
  );
  assertVerifierStatusPolicyAcceptsAuthorityAttestedStatusProofProtocol(
    request.statusPolicy,
    credentialWithStatus.credential.statusBinding,
    statusInputs.statusProofProtocol,
    currentTime
  );
}
