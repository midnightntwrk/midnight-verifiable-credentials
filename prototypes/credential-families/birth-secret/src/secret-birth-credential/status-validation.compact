export circuit assertValidSecretBirthCredentialWithStatusBinding(
  credentialWithStatus: SecretBirthCredentialWithStatusBinding
): [] {
  assertValidSecretBirthSchemaRef(credentialWithStatus.credential.schema);
  SecretBirthStatus_assertValidCredentialEnvelope(
    credentialWithStatus.credential,
    birthCredentialClaimRoot(credentialWithStatus.credential.claims)
  );
  assertValidRegistryBoundStatusBinding(
    credentialWithStatus.credential.statusBinding
  );
  assertValidBlindedSecretHolderCredentialBinding(
    credentialWithStatus.credential.holderBinding
  );
  SecretBirthStatus_assertValidCredentialProofForBodyRoot(
    credentialWithStatus.credential,
    credentialWithStatus.credentialProof,
    secretBirthCredentialWithStatusBindingBodyRoot(credentialWithStatus)
  );
}

export circuit assertValidSecretBirthCredentialVerificationAuthorityAttestedStatusRequest(
  request: SecretBirthCredentialVerificationAuthorityAttestedStatusRequest
): [] {
  assertValidSecretBirthCredentialVerificationRequestMessage(
    request.verificationRequest
  );
  assertValidVerifierStatusPolicy(request.statusPolicy);
  assertValidRevokedSetStatusRequest(request.statusRequest);
  assert(
    request.statusPolicy.requireStatus,
    "Secret birth authority-attested status verification request must require credential status"
  );
  assert(
    request.statusRequest.verifierChallengeHash
      == request.verificationRequest.verifierChallengeHash,
    "Secret birth authority-attested status request challenge must match the verification request challenge"
  );
}

