export struct SecretBirthCredentialWithStatusBinding {
  credential: SecretBirthCredential,
  // This proof commits to the status-aware family body root, not the plain
  // base credential body root.
  credentialProof: Proof,
  statusBinding: RegistryBoundStatusBinding,
}

struct SecretBirthCredentialStatusBoundBody {
  credential: SecretBirthCredential,
  statusBindingRoot: Bytes<32>,
}

export struct SecretBirthCredentialVerificationAuthorityAttestedStatusRequest {
  verificationRequest: SecretBirthCredentialVerificationRequest,
  statusPolicy: VerifierStatusPolicy,
  statusRequest: RevokedSetStatusRequest,
}

export struct SecretBirthCredentialVerificationRevokedSetStatusRequest {
  verificationRequest: SecretBirthCredentialVerificationRequest,
  statusPolicy: VerifierStatusPolicy,
  statusRequest: RevokedSetStatusRequest,
}

export struct SecretBirthCredentialVerificationRevokedSetStatusInputs {
  statusProofProtocol: RevokedSetNonMembershipStatusProofProtocol,
}

export struct SecretBirthCredentialVerificationAuthorityAttestedStatusProtocolInputs {
  statusProofProtocol: AuthorityAttestedStatusProofProtocol,
}
