export struct UniversityDiplomaDisclosures {
  revealLegalName: Boolean,
  legalNamePadded: Bytes<32>,
  legalNameOpening: Bytes<32>,
  revealDocumentType: Boolean,
  documentTypePadded: Bytes<32>,
  documentTypeOpening: Bytes<32>,
  revealDocumentNumber: Boolean,
  documentNumberPadded: Bytes<32>,
  documentNumberOpening: Bytes<32>,
  revealDegreeTitle: Boolean,
  degreeTitlePadded: Bytes<32>,
  degreeTitleOpening: Bytes<32>,
  revealProgram: Boolean,
  programPadded: Bytes<32>,
  programOpening: Bytes<32>,
  revealFaculty: Boolean,
  facultyPadded: Bytes<32>,
  facultyOpening: Bytes<32>,
  revealAwardDate: Boolean,
  awardDateDays: Uint<32>,
  awardDateOpening: Bytes<32>,
  revealGraduationStatus: Boolean,
  graduationStatusPadded: Bytes<32>,
  graduationStatusOpening: Bytes<32>,
}

export struct UniversityDiplomaPresentationRequest {
  version: Uint<16>,
  schema: SchemaRef,
  issuerVerificationMethodRef: VerificationMethodRef,
  requireLegalNameDisclosure: Boolean,
  requireDocumentTypeDisclosure: Boolean,
  requireDocumentNumberDisclosure: Boolean,
  requireDegreeTitleDisclosure: Boolean,
  requireProgramDisclosure: Boolean,
  requireFacultyDisclosure: Boolean,
  requireAwardDateDisclosure: Boolean,
  requireGraduationStatusDisclosure: Boolean,
  verifierChallengeHash: Bytes<32>,
}
