// Birth-family issuance, presentation, and predicate validation.
// =====================
// Issuance-message validation
// =====================
export pure circuit assertValidBirthCredentialIssuanceOffer(
  offer: BirthCredentialIssuanceOffer
): [] {
  BirthCredentialIssuance_assertValidOfferMessage(offer);
  assertValidBirthSchemaRef(offer.schema);
  assert(
    offer.holderBindingProfile == HolderBindingProfile.explicitDid,
    "Birth credential issuance offer must use explicit DID holder binding"
  );
  if (offer.body.supportsExpiration) {
    assert(
      offer.body.defaultExpirationDays > 0,
      "Birth credential issuance offer default expiration must be positive when supported"
    );
  } else {
    assert(
      offer.body.defaultExpirationDays == 0,
      "Birth credential issuance offer default expiration must be zero when expiration is disabled"
    );
  }
}

export pure circuit assertValidBirthCredentialIssuanceRequest(
  request: BirthCredentialIssuanceRequest
): [] {
  BirthCredentialIssuance_assertValidRequestMessage(request);
  assertValidBirthSchemaRef(request.schema);
  assert(
    request.holderBindingProfile == HolderBindingProfile.explicitDid,
    "Birth credential issuance request must use explicit DID holder binding"
  );
  assertValidExplicitHolderBinding(request.body.holderBinding);
  assert(
    request.body.holderChallengeHash != noProtocolResponseReference(),
    "Birth credential issuance request holder challenge must be set"
  );
  if (request.body.requestExpiration) {
    assert(
      request.body.requestedExpirationDays > 0,
      "Birth credential issuance request expiration days must be positive when requested"
    );
  } else {
    assert(
      request.body.requestedExpirationDays == 0,
      "Birth credential issuance request expiration days must be zero when disabled"
    );
  }
}

export pure circuit assertBirthCredentialIssuanceRequestMatchesOffer(
  offer: BirthCredentialIssuanceOffer,
  request: BirthCredentialIssuanceRequest
): [] {
  assertValidBirthCredentialIssuanceOffer(offer);
  assertValidBirthCredentialIssuanceRequest(request);
  BirthCredentialIssuance_assertOfferRequestAlignment(offer, request);
  if (request.body.requestExpiration) {
    assert(
      offer.body.supportsExpiration,
      "Birth credential issuance request cannot require expiration when the offer disables it"
    );
  }
}

export pure circuit assertValidBirthCredentialIssuanceResult(
  result: BirthCredentialIssuanceResult
): [] {
  BirthCredentialIssuance_assertValidResultMessage(result);
  assertValidBirthSchemaRef(result.schema);
  assert(
    result.holderBindingProfile == HolderBindingProfile.explicitDid,
    "Birth credential issuance result must use explicit DID holder binding"
  );
  assertValidBirthCredential(
    result.body.credential,
    result.body.credentialProof
  );
  assert(
    result.body.credentialProof.challengeHash == result.body.issuanceChallengeHash,
    "Birth credential issuance result challenge must match the issuer proof challenge"
  );
}

export pure circuit assertBirthCredentialIssuanceResultMatchesRequest(
  request: BirthCredentialIssuanceRequest,
  result: BirthCredentialIssuanceResult
): [] {
  assertValidBirthCredentialIssuanceRequest(request);
  assertValidBirthCredentialIssuanceResult(result);
  BirthCredentialIssuance_assertRequestResultAlignment(request, result);
  assert(
    request.body.holderChallengeHash == result.body.issuanceChallengeHash,
    "Birth credential issuance result challenge must match the request challenge"
  );
  assertMatchingExplicitHolderBindings(
    request.body.holderBinding,
    result.body.credential.holderBinding
  );
  assert(
    jubjubPointX(request.body.holderPublicKey) == jubjubPointX(result.body.holderPublicKey)
      && jubjubPointY(request.body.holderPublicKey) == jubjubPointY(result.body.holderPublicKey),
    "Birth credential issuance result holder public key does not match the request"
  );
}

// =====================
// Presentation-message validation
// =====================
export pure circuit assertValidBirthCredentialVerificationRequestMessage(
  request: BirthCredentialVerificationRequest
): [] {
  BirthCredentialVerification_assertValidRequestMessage(request);
  assertValidBirthSchemaRef(request.schema);
  assert(
    request.holderBindingProfile == HolderBindingProfile.explicitDid,
    "Birth credential verification request must use explicit DID holder binding"
  );
  assertValidBirthCredentialPresentationRequest(
    birthCredentialPresentationRequestFromProtocol(request)
  );
}

export pure circuit assertValidBirthCredentialVerificationSubmissionMessage(
  submission: BirthCredentialVerificationSubmission
): [] {
  BirthCredentialVerification_assertValidSubmissionMessage(submission);
  assertValidBirthSchemaRef(submission.schema);
  assert(
    submission.holderBindingProfile == HolderBindingProfile.explicitDid,
    "Birth credential verification submission must use explicit DID holder binding"
  );
  assertValidBirthCredentialPresentation(
    submission.body.credential,
    submission.body.credentialProof,
    submission.body.presentation,
    submission.body.presentationProof
  );
  assert(
    submission.body.presentationProof.challengeHash == submission.challengeHash,
    "Birth credential verification submission challenge must match the presentation proof challenge"
  );
}

export pure circuit assertBirthCredentialVerificationSubmissionMatchesRequest(
  request: BirthCredentialVerificationRequest,
  submission: BirthCredentialVerificationSubmission
): [] {
  assertValidBirthCredentialVerificationRequestMessage(request);
  assertValidBirthCredentialVerificationSubmissionMessage(submission);
  BirthCredentialVerification_assertRequestSubmissionAlignment(
    request,
    submission
  );
  assertBirthPresentationSatisfiesRequest(
    submission.body.credential,
    birthCredentialPresentationRequestFromProtocol(request),
    submission.body.presentation,
    submission.body.presentationProof
  );
}

export pure circuit assertValidBirthCredentialVerificationResultMessage(
  result: BirthCredentialVerificationResult
): [] {
  BirthCredentialVerification_assertValidResultMessage(result);
  if (result.approved) {
    assert(
      result.body.credentialRoot != noProtocolResponseReference(),
      "Birth credential verification result must include a credential root when approved"
    );
  }
}

export pure circuit assertBirthCredentialVerificationResultMatchesSubmission(
  submission: BirthCredentialVerificationSubmission,
  result: BirthCredentialVerificationResult
): [] {
  assertValidBirthCredentialVerificationSubmissionMessage(submission);
  assertValidBirthCredentialVerificationResultMessage(result);
  BirthCredentialVerification_assertSubmissionResultAlignment(
    submission,
    result
  );
  if (result.approved) {
    assert(
      result.body.credentialRoot == birthCredentialBodyRoot(submission.body.credential),
      "Birth credential verification result credential root does not match the submission"
    );
  }
}

// =====================
// Credential and presentation validation
// =====================
export pure circuit assertValidBirthCredential(
  credential: BirthCredential,
  proof: Proof
): [] {
  assertValidBirthSchemaRef(credential.schema);
  assertValidCredentialEnvelope(credential, birthCredentialClaimRoot(credential.claimCommitments));
  assertValidNoStatusBinding(credential.statusBinding);
  assertValidExplicitHolderBinding(credential.holderBinding);
  assertValidCredentialProof(credential, proof);
}

export pure circuit assertValidBirthCredentialPresentation(
  credential: BirthCredential,
  credentialProof: Proof,
  presentation: BirthCredentialPresentation,
  presentationProof: Proof
): [] {
  assertValidBirthCredential(credential, credentialProof);
  assertValidBirthSchemaRef(presentation.schema);
  assertValidPresentationEnvelope(presentation);
  BirthCredentialPresentation_assertMatchingCredentialPresentation(
    credential,
    presentation
  );
  assertValidExplicitHolderBinding(presentation.holderBinding);
  assertMatchingExplicitHolderBindings(
    credential.holderBinding,
    presentation.holderBinding
  );

  if (presentation.disclosed.revealSubjectIdCommitment) {
    assert(
      presentation.disclosed.subjectIdCommitment == credential.claimCommitments.subjectIdCommitment,
      "Presentation subject commitment does not match the credential"
    );
  }
  if (presentation.disclosed.revealBirthCountryCode) {
    assert(
      birthCountryCodeCommitment(
        presentation.disclosed.birthCountryCodePadded,
        presentation.disclosed.birthCountryCodeOpening
      ) == credential.claimCommitments.birthCountryCodeCommitment,
      "Presentation birth-country disclosure does not match the credential"
    );
  }
  if (presentation.disclosed.proveAgeOverThreshold) {
    assert(presentation.disclosed.ageThresholdYears > 0, "Age threshold must be positive");
  }

  assertProofMatchesExplicitHolderBinding(
    presentation.holderBinding,
    presentationProof
  );
  assertValidPresentationContextProof(
    birthCredentialPresentationBodyRoot(presentation),
    presentationProof
  );
}

// TRUST BOUNDARY: `request` is verifier-supplied and may be stricter than the
// holder expects. This helper only proves that the presentation satisfies the
// declared request semantics; it does not authenticate who authored the
// request outside the challenge and issuer-binding checks below.
export pure circuit assertBirthPresentationSatisfiesRequest(
  credential: BirthCredential,
  request: BirthCredentialPresentationRequest,
  presentation: BirthCredentialPresentation,
  presentationProof: Proof
): [] {
  assertValidBirthCredentialPresentationRequest(request);
  assertValidBirthSchemaRef(presentation.schema);
  assertMatchingSchemaRefs(request.schema, credential.schema);
  assertMatchingSchemaRefs(request.schema, presentation.schema);
  assert(
    request.issuerVerificationMethodRef.didContractAddress == credential.issuerVerificationMethodRef.didContractAddress,
    "Presentation request issuer contract does not match the credential issuer"
  );
  assert(
    request.issuerVerificationMethodRef.methodId == credential.issuerVerificationMethodRef.methodId,
    "Presentation request issuer method reference does not match the credential issuer"
  );
  assert(
    presentationProof.challengeHash == request.verifierChallengeHash,
    "Presentation proof challenge does not match the request challenge"
  );
  if (request.requireSubjectIdCommitmentDisclosure) {
    assert(
      presentation.disclosed.revealSubjectIdCommitment,
      "Presentation request requires the subject-id commitment disclosure"
    );
  }
  if (request.requireBirthCountryDisclosure) {
    assert(
      presentation.disclosed.revealBirthCountryCode,
      "Presentation request requires the birth-country disclosure"
    );
  }
  if (request.requireAgeOverThreshold) {
    assert(
      presentation.disclosed.proveAgeOverThreshold,
      "Presentation request requires the age-over-threshold predicate"
    );
    assert(
      presentation.disclosed.ageThresholdYears == request.requestedAgeThresholdYears,
      "Presentation age threshold does not match the request"
    );
  }
}

// =====================
// Predicate validation
// =====================
// TRUST BOUNDARY: `currentDay` is caller-supplied policy input. Callers must
// source it from a trustworthy time/calendar oracle when the age predicate is
// used for real acceptance decisions.
export pure circuit assertValidBirthCredentialAgePredicate(
  credential: BirthCredential,
  presentation: BirthCredentialPresentation,
  currentDay: Uint<32>,
  birthDateDays: Uint<32>,
  birthDateOpening: Bytes<32>
): [] {
  assert(
    presentation.disclosed.proveAgeOverThreshold,
    "Presentation must request the age-over-threshold predicate"
  );
  assert(
    birthDateCommitment(birthDateDays, birthDateOpening) == credential.claimCommitments.birthDateCommitment,
    "Birth-date witness does not match credential commitment"
  );
  assert(currentDay >= birthDateDays, "Current day must not precede the birth date witness");
  assert(
    currentDay - birthDateDays >= presentation.disclosed.ageThresholdYears * 365,
    "Age predicate does not satisfy the requested threshold"
  );
}
