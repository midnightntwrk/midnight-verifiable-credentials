pragma language_version >= 0.20;

import CompactStandardLibrary;

include "../../../core/primitives/credentials/src/credentials";
include "./status-proof-protocol";

export ledger registryId: Bytes<32>;
export ledger initialized: Boolean;
export ledger version: Counter;
export ledger revokedStatusHandleCount: Counter;
export ledger revokedStatusHandles: MerkleTree<32, Bytes<32>>;

constructor() {
  registryId = pad(32, "midnight:vc:status:unset");
  initialized = false;
}

pure circuit revocationRegistryState(
  registryIdValue: Bytes<32>,
  revokedRoot: Bytes<32>,
  registryVersionValue: Uint<64>
): RevocationRegistryState {
  return RevocationRegistryState {
    registryId: registryIdValue,
    revokedRoot: revokedRoot,
    registryVersion: registryVersionValue,
  };
}

export circuit initializeRegistry(nextRegistryId: Bytes<32>): [] {
  assert(!initialized, "Revocation registry has already been initialized");
  assert(
    nextRegistryId != pad(32, ""),
    "Revocation registry id must be set"
  );
  assert(
    nextRegistryId != pad(32, "midnight:vc:status:unset"),
    "Revocation registry id must not reuse the unset sentinel"
  );
  registryId = disclose(nextRegistryId);
  initialized = true;
}

// Current prototype limitation: Compact does not yet expose an in-circuit
// getter for the current MerkleTree root here, so this circuit only binds the
// caller-provided snapshot to this registry's id and monotonic version only.
// Callers must not treat `state.revokedRoot` as contract-verified until the
// final in-circuit non-membership/root-binding path lands.
export circuit assertStateUsesThisRegistry(
  state: RevocationRegistryState
): [] {
  assert(initialized, "Revocation registry is not initialized");
  assertValidRevocationRegistryState(state);
  assert(
    state.registryId == registryId,
    "Revocation registry state does not belong to this registry"
  );
  assert(
    state.registryVersion == version,
    "Revocation registry state version does not match this registry"
  );
}

export circuit revokeStatusHandle(statusHandle: Bytes<32>): [] {
  assert(initialized, "Revocation registry is not initialized");
  assert(statusHandle != pad(32, ""), "Revoked status handle must be set");
  revokedStatusHandles.insert(disclose(statusHandle));
  revokedStatusHandleCount.increment(1);
  version.increment(1);
}
