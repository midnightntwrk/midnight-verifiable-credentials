{
  "name": "@midnight-ntwrk/midnight-did-credentials-status-registry",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "require": "./dist/contract.js",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "require": "./dist/testing.js",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./managed/revocation-registry/contract/index.js": {
      "types": "./dist/managed/revocation-registry/contract/index.d.ts",
      "import": "./dist/managed/revocation-registry/contract/index.js",
      "default": "./dist/managed/revocation-registry/contract/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "contract": [
        "dist/contract.d.ts"
      ],
      "testing": [
        "dist/testing.d.ts"
      ],
      "managed/revocation-registry/contract/index.js": [
        "dist/managed/revocation-registry/contract/index.d.ts"
      ]
    }
  },
  "scripts": {
    "prepare:credentials": "npm --prefix ../../core/primitives/credentials run build",
    "contract": "npm run compact",
    "compact": "node ../../tooling/scripts/ensure-compact-package-aliases.mjs && compact compile src/revocation-registry.compact src/managed/revocation-registry && node ./scripts/align-runtime-version.mjs && node ./scripts/strip-managed-sourcemaps.mjs",
    "pretest": "npm run prepare:credentials && npm run compact",
    "pretest:ci": "npm run prepare:credentials && npm run compact",
    "test": "vitest run",
    "test:ci": "vitest run",
    "prepack": "npm run build",
    "clean": "rm -rf dist && rm -rf coverage && rm -rf reports && rm -rf src/managed",
    "build": "npm run prepare:credentials && npm run compact && rm -rf dist && mkdir -p dist && tsc -b tsconfig.build.json --force && cp -Rf ./src/managed ./dist/ && cp ./src/revocation-registry.compact ./dist && cp ./src/status-proof-protocol.compact ./dist",
    "lint": "eslint src --ignore-pattern 'src/managed/**'",
    "lint:fix": "eslint src --fix --ignore-pattern 'src/managed/**'",
    "typecheck": "npm run prepare:credentials && npm run compact && tsc -p tsconfig.json --noEmit",
    "all": "npm run build && npm run test:ci"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "*",
    "@midnight-ntwrk/midnight-did-credentials": "*"
  },
  "files": [
    "dist/**",
    "src/**/*.compact",
    "README.md",
    "tooling/scripts/*.mjs",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ]
}
