export circuit registryBoundStatusBindingRoot(
  binding: RegistryBoundStatusBinding
): Bytes<32> {
  assertValidRegistryBoundStatusBinding(binding);
  return persistentHash<RegistryBoundStatusBinding>(binding);
}

export circuit registryBoundStatusBindingFromRevokedSetNonMembershipStatusCapability(
  capability: RevokedSetNonMembershipStatusCapability
): RegistryBoundStatusBinding {
  assertValidRevokedSetNonMembershipStatusCapability(capability);
  return RegistryBoundStatusBinding {
    registryRef: capability.registryRef,
    statusHandleCommitment: capability.statusHandleCommitment,
  };
}

export circuit registryBoundStatusBindingFromAuthorityAttestedStatusCapability(
  capability: AuthorityAttestedStatusCapability
): RegistryBoundStatusBinding {
  assertValidAuthorityAttestedStatusCapability(capability);
  return RegistryBoundStatusBinding {
    registryRef: capability.registryRef,
    statusHandleCommitment: capability.statusHandleCommitment,
  };
}
